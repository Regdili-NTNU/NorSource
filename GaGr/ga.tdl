;;;        ga.tdl
;;;
;;; Main type file for constructions in Ga
;;; (some specifications are also more general, but less general than those in matrix.tdl




inflection := sort.
irreg := inflection.
reg := inflection.


asp-mod := avm &
 [  ASPECT aspect,
    MOOD mood,
    TENSE tense,
    K actnt ]. 

aspmod-v-full := asp-mod.
aspmod-v-red := aspmod-v-full &
  [ ASPECT.PROSP - ].
aspmod-prev-deict := aspmod-v-full &
  [ ASPECT.PROGR - ].
aspmod-prev-neg := aspmod-prev-deict &
  [ MOOD non-volitional ].


deict := sort.
ingress := deict.
egress := deict.



mood := sort.
indicative := mood.
non-volitional := mood.
aspect := sort &
 [ COMPL bool,
   MULTEV bool,
   PROSP bool,
   PROGR bool ].

perfect := aspect &
 [ COMPL +,
   MULTEV -,
   PROSP -,
   PROGR - ].
progressive := aspect &
 [ COMPL -,
   MULTEV -,
   PROSP -,
   PROGR + ].
habitual := aspect &
 [ COMPL -,
   MULTEV +,
   PROSP - ].
future := aspect &
 [ COMPL -,
   MULTEV -,
   PROSP + ].
aorist := aspect.

;subjunctive := non-volitional.
imperative := non-volitional.
;plur-imperative := non-volitional.



mode := avm.
decl := mode.
interr := mode.
yn-interr := interr.
wh-interr := interr.
irrealis := mode.
cond := mode.
hyp := mode.
equat := mode.



tense := avm.
finite := tense.
present := finite.
pres := finite.
past := finite.
fut := finite.
nonfinite := tense.
infin := nonfinite.
gerund := nonfinite.
perfprtcpl := nonfinite.
presprtcpl := nonfinite.
passprtcpl := nonfinite.


achievement := aspect.
activity-asp := aspect.
activation := aspect.
compl_monodvmnt := monodvmnt & completion.
compl_activity := aspect.
completion := aspect.
dynamic := aspect.
;event := aspect.
generic := aspect.
;habitual := aspect.
inchoative := aspect.
incremresult := aspect.
iteration := aspect.
monodvmnt := aspect.
noncompl := aspect.
noncompl_monodvmnt :=  monodvmnt & noncompl.
process-asp := aspect.
;progressive := aspect.
protrct := aspect.
semelfctive := aspect.
stative := aspect.
telic-asp := aspect.


; POS values

agr := avm & [TARGTD bool].
pernum := agr.
3sing := pernum.
non-3sing := pernum.
genus := agr.
nounclass := agr.
animacy := agr.

case := avm.
nominative := case.
accusative := case.
dative := case.
genitive := case.
ablative := case.
vocative := case.
illative := case.
allative := case.
ergative := case.
absolutive := case.

pronreal := avm.
clitic := pronreal.
weak := pronreal.
full := pronreal.
nul := pronreal.
drop := pronreal.

formative := avm.
asp-form := formative.
perf := asp-form.
prog := asp-form.
aor := asp-form.
hab := asp-form.
diat-form := formative.
pass := diat-form.
middle := diat-form.
applic := formative.
caus := formative.


agr-pos := head &
[ AGRMT agr ].
non-agr-pos := head & [FRMTVS list,
		      SM agr,
		      OM agr].
nom := agr-pos & [MOD <>,
		  CASE case,
		  DEF bool,
		  ACCUSATIVE bool,
		  EXPLETIVE bool].

posspron := head.
noun := nom. 
pron := nom & [REAL pronreal].
verb-all-super := non-agr-pos.
verb-all := verb-all-super.
main-verb := verb-all.
pre-verb := verb-all.
verbid := verb-all-super &
  [ MOD < [ LOCAL.CAT.HEAD main-verb ] > ].
copula := verb-all.
verb := non-agr-pos & [MOD <>].
mainverb := verb.
auxverb := verb.
preverb := verb.
modaux := auxverb.
perfaux := auxverb.
nomverb := verb.
det := agr-pos & [MOD <>].
q := agr-pos & [MOD <>].
art := agr-pos & [MOD <>].
quantor := agr-pos & [MOD <>].
quant:= quantor.
compltzr := head. 
decl-compltzr := compltzr.
yn-compltzr := compltzr.
wh-compltzr := compltzr.
infmark := non-agr-pos.
adjective := non-agr-pos & [MOD <[]>].
adjectival := head.
adj := adjectival.
; &
;  [ MOD < [ LOCAL.CAT.HEAD noun ] > ].
card := adjectival.
comp := head.
adv := head.
prep := head.
particle := non-agr-pos & [MOD < >].
predparticle := non-agr-pos & [MOD < >].
adverb := non-agr-pos & [MOD < [CMPS <>] >].
connect := head.
punct := connect.
conn-pos := connect.
conn-adv := conn-pos.
conn-coord := conn-pos.
coord := conn-pos.

; Introduced in matrix.tdl as
;ref-ind := index & event-or-ref-index &
;  [ PNG png,
;    ROLE role ].
;to be used with care, to avoid colliding role specifications in cases of coindexation.

role := avm.
agent := role.
patient := role.
theme := role.
beneficiary := role.
orientedobj := role.
purely-oriented-obj := orientedobj.
mileage-obj := orientedobj.
pathobj := mileage-obj.
locomo-instance := mileage-obj.
locomotor := locomo-instance.
ag-mover := locomotor & agent.
theme-mover := locomotor & theme.
theme-path := pathobj & theme.
locomoevent := locomo-instance.
spatial-entity := role.
endpnt := spatial-entity.
startpnt := spatial-entity.
viapnt := spatial-entity.
theme-abstr := theme.
theme-sit := theme.
theme-locative := theme.
idfd := role.
idfng := role.
affincrem := role.
affected := role.
activated := role.
agintent := role.
agmover := role.
agsenser := role.
alongline := role.
assessor := role.
cognizer := role.
comitative := role.
content := role.
caused := role.
causee := role.
causer := role.
distunit := role.
ejcted := role.
effector := role.
endstate := role.
eventunit := role.
experiencer := role.
instr := role.
instrsit := role.
interloc := role.
lengthunit := role.
;loc := role.
locus := role.
locsit := role.
malefactive := role. 
measure := role. 
located-obj := role.
orientedline := role.
percept := role.
perceptSit := role.
permissee := role.
possessor := role.
possAbst := role.
possessed := role.
presented := role.
purelyorient := role.
quality := role.
recipient := role.
result := role.
senser := role.
target := role.
time := role.
timeunit := role.
thincrem := theme.
thvehcl := theme.
topic := role.
weightunit := role.



;;;;;;;;;;;;;;;;;;;;;;;;
;;; HEAD.KEYS.KEY
verball := predsort.
verball-sin-ke := verball.
ke-key := verball.
verball-sin-ke-ka := verball-sin-ke.
ka-key := verball-sin-ke.
verball-sin-ke-ka-deict := verball-sin-ke-ka.
deict-key := verball-sin-ke-ka.
mainverb-key := verball-sin-ke-ka-deict.
;;;


; BASIC LEX-ITEMS TYPES

lex-item-1rel := word-or-lexrule &
  [SYNSEM.LOCAL.CONT [RELS [ LIST.FIRST #2 & [ARG0 #1],
                             LIST.REST #rest,
                             LAST #rest ],
                      HOOK.INDEX #1],
   SYNSEM.LKEYS.KEYREL #2 & relation ].

lex-item-2rel := word-or-lexrule &
[ SYNSEM. LOCAL.CONT.HOOK.INDEX #1,
  SYNSEM.LOCAL.CONT.RELS [ LIST.FIRST #key,
                           LIST.REST [FIRST #relation,             
                                      REST #rest],
                           LAST #rest],
  SYNSEM.LKEYS.KEYREL #key & [ ARG0 #1],
  SYNSEM.LKEYS.ALTKEYREL #relation & [ ARG0 #1] ].


lex-item-3rel := word-or-lexrule &
[ SYNSEM.LOCAL.CONT.HOOK.INDEX #1,
  SYNSEM.LOCAL.CONT.RELS [ LIST.FIRST #key,
                           LIST.REST [FIRST relation,             
                                      REST [FIRST relation,
                                            REST #rest]],
                           LAST #rest],
  SYNSEM.LKEYS.KEYREL #key & [ ARG0 #1]].

lex-item-4rel := word-or-lexrule &
[ SYNSEM.LOCAL.CONT.HOOK.INDEX #1,
  SYNSEM.LOCAL.CONT.RELS [ LIST.FIRST #key,
                           LIST.REST [FIRST relation,
                                      REST [FIRST #relation,
                                            REST [FIRST relation & [ ARG0 #1],
                                                  REST  #rest]]],
                           LAST #rest],
  SYNSEM.LKEYS.KEYREL #key,
  SYNSEM.LKEYS.ALTKEYREL #relation ].

lex-item-5rel := word-or-lexrule &
[ SYNSEM.LOCAL.CONT.HOOK.INDEX #1,
  SYNSEM.LOCAL.CONT.HOOK.XARG #4,
  SYNSEM.LOCAL.CONT.RELS [ LIST.FIRST #key,
                           LIST.REST [FIRST #relation & [ ARG0 #1,
                                                          ARG1 #4],
                                      REST [FIRST relation,
                                            REST [FIRST relation,
                                                  REST [FIRST relation,
                                                        REST #rest]]]],
                           LAST #rest],
  SYNSEM.LKEYS.KEYREL #key,
  SYNSEM.LKEYS.ALTKEYREL #relation ].

lex-item-6rel := word-or-lexrule &
[ SYNSEM.LOCAL.CONT.HOOK.INDEX #1,
  SYNSEM.LOCAL.CONT.HOOK.XARG #4,
  SYNSEM.LOCAL.CONT.RELS [ LIST.FIRST #key,
                           LIST.REST [FIRST #relation & [ ARG0 #1,
                                                          ARG1 #4],
                                      REST [FIRST relation,
                                            REST [FIRST relation,
                                                  REST [FIRST relation,
                                                        REST [FIRST relation,
                                                              REST #rest]]]]],
                           LAST #rest],
  SYNSEM.LKEYS.KEYREL #key,
  SYNSEM.LKEYS.ALTKEYREL #relation ].



; this (expanded) type is equiv to 'norm-lex-item'
lbl-ltop-lex-item := lex-item-1rel &
  [ SYNSEM.LOCAL.CONT.HOOK.LTOP #1,
    SYNSEM.LKEYS.KEYREL.LBL #1 ].

lbl-ltop-lex-item-2rel := lex-item-2rel &
  [ SYNSEM.LOCAL.CONT.HOOK.LTOP #1,
    SYNSEM.LKEYS.KEYREL.LBL #1 ]. 


lbl-ltop-lex-item-3rel := lex-item-3rel &
  [ SYNSEM.LOCAL.CONT.HOOK.LTOP #1,
    SYNSEM.LKEYS.KEYREL.LBL #1 ].

lbl-ltop-lex-item-4rel := lex-item-4rel &
  [ SYNSEM.LOCAL.CONT.HOOK.LTOP #1,
    SYNSEM.LKEYS.KEYREL.LBL #1 ].

lbl-ltop-lex-item-5rel := lex-item-5rel &
  [ SYNSEM.LOCAL.CONT.HOOK.LTOP #1,
    SYNSEM.LKEYS.KEYREL.LBL #1 ].

lbl-ltop-lex-item-6rel := lex-item-6rel &
  [ SYNSEM.LOCAL.CONT.HOOK.LTOP #1,
    SYNSEM.LOCAL.CONT.RELS <! [], [ LBL #1 ], [], [], [], [] !> ].

reg-mod-lex-item := lbl-ltop-lex-item &
  [ SYNSEM.LOCAL.CAT.HEAD.MOD < [ LOCAL.CONT.HOOK.INDEX #1,
                                  LOCAL.CONT.HOOK.LTOP #2,
                                  LKEYS.KEYREL.LBL #2,
                                  LOCAL.CAT.VAL.COMPS olist]>,
    SYNSEM.LOCAL.CAT.VAL [ SUBJ <>,
                           SPR <>,
                           SPEC <> ],
    SYNSEM.LKEYS.KEYREL [ ARG1 #1,
                          LBL #2 ],
    SYNSEM.LOCAL.CONT.HCONS <! !>,
    SYNSEM.LOCAL.CONT.HOOK.XARG #1 ].

dir-mod-lex-item := lbl-ltop-lex-item &
  [ SYNSEM.LOCAL.CAT.HEAD.MOD < [ LOCAL.CONT.HOOK.DIRARG #1,
                                  LOCAL.CONT.HOOK.LTOP #2,
                                  LKEYS.KEYREL.LBL #2,
                                  LOCAL.CAT.VAL.COMPS olist]>,
    SYNSEM.LOCAL.CAT.VAL [ SUBJ <>,
                           SPR <>,
                           SPEC <> ],
    SYNSEM.LKEYS.KEYREL [ ARG1 #1,
                          LBL #2 ],
    SYNSEM.LOCAL.CONT.HCONS <! !> ].

dir-mod-lex-item-2 := lbl-ltop-lex-item &
  [ SYNSEM.LOCAL.CAT.HEAD.MOD < [ LOCAL.CONT.HOOK.DIRARG #1,
                                  LOCAL.CONT.HOOK.LTOP #2,
                                  LKEYS.KEYREL.LBL #2,
                                  LOCAL.CAT.VAL.COMPS <>]>,
    SYNSEM.LOCAL.CAT.VAL [ SUBJ list,
                           SPR <>,
                           SPEC <> ],
    SYNSEM.LKEYS.KEYREL [ ARG1 #1,
                         LBL #2 ],
    SYNSEM.LOCAL.CONT.HOOK.XARG #1,
    SYNSEM.LOCAL.CONT.HCONS <! !> ].

xarg-mod-lex-item-2 := lbl-ltop-lex-item &
  [ SYNSEM.LOCAL.CAT.HEAD.MOD < [ LOCAL.CONT.HOOK.XARG #1,
                                  LOCAL.CONT.HOOK.LTOP #2,
                                  LKEYS.KEYREL.LBL #2,
                                  LOCAL.CAT.VAL.COMPS <>]>,
    SYNSEM.LOCAL.CAT.VAL [ SUBJ cons,
                           SPR <>,
                           SPEC <> ],
    SYNSEM.LKEYS.KEYREL [ ARG1 #1,
                                  LBL #2 ],
    SYNSEM.LOCAL.CONT.HOOK.XARG #1,
    SYNSEM.LOCAL.CONT.HCONS <! !> ].


; WORD TYPES

connector := word-or-lexrule &
  [  SYNSEM.LOCAL.CONT.RELS <! !>,
     SYNSEM.LOCAL.CAT.HEAD connect ].

punctuation := connector &
  [  SYNSEM.LOCAL.CAT.HEAD punct ].

connect-word := connector &
  [  SYNSEM.LOCAL.CAT.HEAD conn-pos ].

connect-adv-word := connect-word &
  [  SYNSEM.LOCAL.CAT.HEAD conn-adv ].

connect-coord-word := connect-word &
  [  SYNSEM.LOCAL.CAT.HEAD conn-coord ].

coordinating-word := word &
  [ SYNSEM.LOCAL.CAT.HEAD coord,
    SYNSEM.LOCAL.CONT.HOOK.INDEX #2,
    SYNSEM.LOCAL.CONT.RELS <! conjunction-relation &
                            [ C-ARG #2,
                              LBL #5,
                              R-INDEX #1,
                              R-HNDL #3,
                              L-INDEX #6 ], conj-q-rel &
                                            [ ARG0 #2,
                                              RSTR #4 ] !>,
    SYNSEM.LOCAL.CONT.HCONS <! [ HARG #4,
                                 LARG #5 ] !>,
    SYNSEM.LOCAL.CONT.HOOK.XARG #6,
    SYNSEM.LOCAL.CAT.VAL.COMPS < [LOCAL.CAT.HEAD noun,
                                  LOCAL.CONT.HOOK.INDEX #1,
                                  LOCAL.CONT.HOOK.LTOP #3 ] > ].

basic-compl := word &
  [SYNSEM.LOCAL.CAT.HEAD comp,
   SYNSEM.LOCAL.CAT.VAL.COMPS < [LOCAL.CONT.HOOK.INDEX.E.TENSE #2 & tense ]>,
   SYNSEM.LOCAL.CONT.HOOK.INDEX.E.TENSE #2 ].

subord-comp :=  basic-compl & lbl-ltop-lex-item &
  [ SYNSEM.LOCAL.CAT.VAL.COMPS < [ LOCAL.CAT.VAL.SUBJ < anti-synsem >,    
                                   LOCAL.CAT.VAL.COMPS olist,
                                   LOCAL.CAT.VAL [SPR <>,
                                                  SPEC <>],
                                   LOCAL.CONT.HOOK.INDEX.E.TENSE finite,
                                   LOCAL.CONT.HOOK.LTOP #4 ]>,
   SYNSEM.LOCAL.CONT.HOOK.LTOP #3,
   SYNSEM.LOCAL.CONT.RELS <! arg1-relation & [LBL #3,
                                              ARG1 #4] !>,
   SYNSEM.LOCAL.CONT.HCONS <!  !> ].

;decl-subord-comp := subord-comp &
;  [ SYNSEM.LOCAL.CAT.HEAD.DECL +,
;    SYNSEM.LOCAL.CAT.VAL.COMPS < [ LOCAL.CAT.HEAD.DECL + ] >].

;reg-mod-lex-item & 
prep-word := word &
  [ SYNSEM arg2-comps-synsem & [LOCAL.CAT.HEAD prep ],
    SYNSEM.LOCAL.CAT.VAL.COMPS < #1 >,
    SYNSEM.LOCAL.CAT.VAL.SPEC <>,
    SYNSEM.LOCAL.CAT.VAL.SUBJ <>,
    SYNSEM.LOCAL.CAT.QVAL.DOBJECT #1,
    SYNSEM.LOCAL [ CONT.HOOK.XARG #2 ],
    SYNSEM.LKEYS.KEYREL arg12-relation & [ARG1 #2 ] ].

prep-n-word := prep-word &
  [ SYNSEM [LOCAL.CAT [ VAL.COMPS 1-list & [FIRST.LOCAL.CAT.HEAD nom,
                                            FIRST.LOCAL.CONT.HOOK.INDEX #1,
                                            FIRST.LOCAL.DERIVED-HEAD bool],
                        QVAL.DOBJECT.LOCAL.CONT.HOOK.INDEX #1]] ].

prep-word-sel := reg-mod-lex-item & prep-n-word &
  [ SYNSEM.LOCAL.CAT.HEAD.MOD <[LOCAL.CAT.HEAD verb-all]>, 
    SYNSEM.LKEYS.KEYREL [ ARG1 #mod ],
    SYNSEM.LOCAL.CONT.HOOK.XARG #mod, 
    SYNSEM.LOCAL.CAT.HEAD prep & [SELECTED +,
				  KEYS.KEY fct-spec,
				  MOD list],
    SYNSEM.LOCAL.CONT.HOOK.VARG #1,
    SYNSEM.LOCAL.GF.GOV.INDX #1,
    SYNSEM.LOCAL.CAT.VAL.COMPS < [LOCAL.CONT.HOOK.INDEX ref-ind & #1 & [SORT referential-thing],
                                  LOCAL.CAT.HEAD nom] >,
    SYNSEM.LOCAL.DERIVED-HEAD -,
    SYNSEM.LOCAL.CONT.RELS <! arg12-relation & [ARG2 #1] !> ].
                             
                             

adjectival-word := word &
  [ SYNSEM.LOCAL.CAT.HEAD adjectival,
    SYNSEM.LOCAL.CAT.VAL.SUBJ <>,
    SYNSEM.LOCAL.CAT.VAL.SPR <>,
    SYNSEM.LOCAL.CAT.VAL.SPEC list,
    SYNSEM.LOCAL.CAT.VAL.COMPS <>].

adjective-word := adjectival-word &
  [ SYNSEM.LOCAL.CAT.HEAD adj ].

plur-adj-word := adjective-word & infl-ltow-rule &
  [ SYNSEM.LKEYS.KEYREL.ARG1.PNG pl,
    DTR adjective-lexeme ]. 

sg-adj-word := adjective-word & const-ltow-rule &
  [ SYNSEM.LKEYS.KEYREL.ARG1.PNG sg,
    DTR adjective-lexeme ].

 ;new def

#|
det-word := lbl-ltop-lex-item &
  [ SYNSEM.LOCAL.CAT.HEAD det,
    SYNSEM.LOCAL.CAT.VAL [ SUBJ <>,
                           SPR <>,
                           COMPS <>,
                           SPEC < [LOCAL.CONT.HOOK.INDEX #1,
                                   LOCAL.CONT.RELS <! [] !>] >],
    SYNSEM.LOCAL.CONT.HOOK.INDEX #1, 
    SYNSEM.LOCAL.CONT.RELS <! [] !>,
    SYNSEM.LOCAL.CONT.HCONS <!!> ].
|#
#|
indef-card-quantifier-word-sup := lbl-ltop-lex-item & word & no-slash & const-ltow-rule & 
  [ SYNSEM.LOCAL.CAT.HEAD q,
    SYNSEM.LOCAL.CONT.HOOK.INDEX #1,
    SYNSEM.LOCAL.CAT.VAL [ SUBJ list,
                           SPR list,
                           COMPS <>,
                           SPEC < [LOCAL.CAT.HEAD np-head,
                                   LOCAL.CONT.HOOK.INDEX #1,
                                   LOCAL.CONT.HOOK.LTOP #3]>],
    SYNSEM.LOCAL.CONT.HOOK comp-hook & [ INDEX #1 & [WH -] ],
    SYNSEM.LOCAL.CONT.HCONS <! [HARG #2,
                                LARG #3 ] !>,
    SYNSEM.LOCAL.CONT.RELS <! indef-q-rel & [ARG0 #1,
                                             RSTR #2 ] !>,
    SYNSEM.LOCAL.BINDING.BOUND - ].
|#

quant-word := lbl-ltop-lex-item & word & 
  [ SYNSEM.LOCAL.CAT.HEAD quantor,
    SYNSEM.LOCAL.CONT.HOOK.INDEX #1,
    SYNSEM.LOCAL.CAT.VAL [ SUBJ list,
                           SPR list,
                           COMPS <>,
                           SPEC < [LOCAL.CAT.HEAD noun,
                                   LOCAL.CONT.HOOK.INDEX #1,
                                   LOCAL.CONT.HOOK.LTOP #3]>],
    SYNSEM.LOCAL.CONT.HOOK [ INDEX #1 ],
    SYNSEM.LOCAL.CONT.HCONS <! [HARG #2,
                                LARG #3 ] !>,
    SYNSEM.LOCAL.CONT.RELS <! indef-q-rel & [ARG0 #1,
                                             RSTR #2 ] !> ].


det-word := lbl-ltop-lex-item & 
  [ SYNSEM.LOCAL.CAT.HEAD det,
    SYNSEM.LOCAL.CONT.HOOK.INDEX #1,
    SYNSEM.LOCAL.CAT.VAL [ SUBJ list,
                           SPR list,
                           COMPS <>,
                           SPEC < [LOCAL.CONT.HOOK.INDEX #1,
                                   LOCAL.CONT.HOOK.LTOP #3]>],
    SYNSEM.LOCAL.CONT.HCONS <! [HARG #2,
                                LARG #3 ] !>,
    SYNSEM.LOCAL.CONT.RELS <!  [ARG0 #1,
				RSTR #2 ] !> ].

#|
quant-word := lbl-ltop-lex-item &
  [ SYNSEM.LOCAL.CAT.HEAD quantor,
    SYNSEM.LOCAL.CAT.VAL [ SUBJ <>,
                           SPR <>,
                           COMPS <>,
                           SPEC < [LOCAL.CONT.HOOK.INDEX #1,
                                   LOCAL.CONT.RELS <! [] !>] >],
    SYNSEM.LOCAL.CONT.HOOK.INDEX #1, 
    SYNSEM.LOCAL.CONT.RELS <! [] !>,
    SYNSEM.LOCAL.CONT.HCONS <!!> ].
|#

proper-name-word := lbl-ltop-lex-item & word &
  [ SYNSEM.LOCAL.CAT.HEAD noun,
    SYNSEM.LOCAL.CONT.HOOK.INDEX ref-ind,
    SYNSEM.LOCAL.CAT.VAL.SUBJ <>,
    SYNSEM.LOCAL.CAT.VAL.SPEC <>,
    SYNSEM.LOCAL.CAT.VAL.COMPS <>,
    SYNSEM.LOCAL.CONT.RELS <!  named-relation  !>].


pers-pron-word := lbl-ltop-lex-item-2rel & word & rule &
  [ SYNSEM.LOCAL.CAT.HEAD noun,
    SYNSEM.LOCAL.CONT.HOOK.INDEX ref-ind,
    SYNSEM.LOCAL.CAT.VAL [ SUBJ <>,
                           SPR < >,
                           COMPS <> ],
    SYNSEM.LOCAL.CONT.RELS <!  pers-pron-rel & [ARG0 #2,
                                                LBL #3],
                               contextual-q-rel & [ARG0 #2,
                                                   RSTR #4] !>,
    SYNSEM.LOCAL.CONT.HCONS <! [HARG #4,
                                LARG #3] !>,
    RULE card-ok ].




poss-pron-word := lbl-ltop-lex-item-4rel & word &
  [ SYNSEM.LOCAL.CAT.HEAD posspron,
    SYNSEM.LOCAL.CONT.HOOK.INDEX #5 & ref-ind,
    SYNSEM.LOCAL.CAT.VAL [ SUBJ <>,
                           SPR < >,
                           SPEC < [LOCAL.CONT.HOOK.INDEX #5,
                                   LOCAL.CONT.HOOK.LTOP #7 ] >,
                           COMPS <> ],
    SYNSEM.LOCAL.CONT.RELS <!  pers-pron-rel & [ARG0 #1,
                                                LBL #3],
                               contextual-q-rel & [ARG0 #1,
                                                   RSTR #4],
                            poss-rel & [ ARG1 #1,
                                         ARG2 #5 ],
                            def-q-rel & [ ARG0 #5,
                                        RSTR #6 ] !>,
    SYNSEM.LOCAL.CONT.HCONS <! [HARG #4,
                                LARG #3], [HARG #6,
                                           LARG #7] !>].
  


1st-poss-pron := poss-pron-word &
  [SYNSEM.LKEYS.KEYREL 1st-pers-pron-rel ].

#|
noun-word := word & lexeme-to-word-rule &
  [ DTR noun-lexeme,
    SYNSEM.LOCAL.CAT.HEAD noun,
    SYNSEM.LOCAL.CAT.VAL.SPEC list,
    SYNSEM.LOCAL.CAT.VAL.COMPS <>].

plur-noun-word := noun-word & infl-ltow-rule &
  [SYNSEM.LOCAL.CONT.HOOK.INDEX.PNG pl ].

sg-noun-word := noun-word & const-ltow-rule &
  [SYNSEM.LOCAL.CONT.HOOK.INDEX.PNG sg ].
|#

noun-word := word & lexeme-to-word-rule &
  [ SYNSEM.LOCAL.CAT.HEAD noun,
    SYNSEM.LOCAL.CAT.VAL.SPEC list,
    SYNSEM.LOCAL.CAT.VAL.COMPS <>].

plur-noun-word := noun-word & const-ltow-rule &
  [ DTR pl-noun-lexeme,
    SYNSEM.LOCAL.CONT.HOOK.INDEX.PNG pl ].

sg-noun-word := noun-word & const-ltow-rule &
  [ DTR noun-lexeme,
    SYNSEM.LOCAL.CONT.HOOK.INDEX.PNG sg ].


verb-word := word & lexeme-to-word-rule &
  [ SYNSEM.LOCAL.CAT.HEAD verb-all-super,
    SYNSEM.LOCAL.CAT.VAL.SPR <>,
    SYNSEM.LOCAL.CAT.VAL.SPEC <>,
    CAN-PREVERB-CMB #1,
    PREVERB-RESP-DISCHRGD #2,
    BY-DELETION #3,
    DTR.PREVERB-RESP-DISCHRGD #2,
    DTR.CAN-PREVERB-CMB #1,
    DTR.BY-DELETION #3 ].

noninfl-verb-word := verb-word & const-ltow-rule.

progr-verb-word := verb-word & infl-ltow-rule &
  [ SYNSEM.LOCAL.CONT.HOOK.INDEX.E.ASPECT progressive,
    SYNSEM.LOCAL.CONT.HOOK.INDEX.E.MOOD indicative,
    SYNSEM.EXPNT-PROG +].

perf-verb-word := verb-word & infl-ltow-rule &
  [ SYNSEM.LOCAL.CONT.HOOK.INDEX.E.ASPECT perfect,
    SYNSEM.LOCAL.CONT.HOOK.INDEX.E.MOOD indicative,
    SYNSEM.EXPNT-PERF +].

habit-verb-word := verb-word & infl-ltow-rule &
  [ SYNSEM.LOCAL.CONT.HOOK.INDEX.E.ASPECT habitual,
    SYNSEM.LOCAL.CONT.HOOK.INDEX.E.MOOD indicative,
    SYNSEM.EXPNT-HAB +].

aorist-verb-word := verb-word & infl-ltow-rule &
  [ SYNSEM.LOCAL.CONT.HOOK.INDEX.E.ASPECT aorist,
    SYNSEM.LOCAL.CONT.HOOK.INDEX.E.MOOD indicative].

future-verb-word := verb-word & infl-ltow-rule &
  [ SYNSEM.LOCAL.CONT.HOOK.INDEX.E.ASPECT future,
    SYNSEM.EXPNT-FUT +].

subjunctive-verb-word := verb-word & infl-ltow-rule &
  [ SYNSEM.LOCAL.CONT.HOOK.INDEX.E.MOOD non-volitional,
    SYNSEM.EXPNT-SBJN +].

imperative-verb-word := verb-word & infl-ltow-rule &
  [ SYNSEM.LOCAL.CONT.HOOK.INDEX.E.MOOD imperative].

plur-imperative-verb-word := verb-word & infl-ltow-rule &
  [ SYNSEM.LOCAL.CAT.VAL.SUBJ <[LOCAL.CONT.HOOK.INDEX.PNG pl]>,
    SYNSEM.LOCAL.CONT.HOOK.INDEX.E.MOOD imperative].

infl-imp-verb-word := verb-word & infl-ltow-rule &
  [ DTR imperative-verb-lexeme,
    SYNSEM.LOCAL.CONT.HOOK.INDEX.E.MOOD imperative].

const-imp-verb-word := verb-word & const-ltow-rule &
  [ DTR imperative-verb-lexeme,
    SYNSEM.LOCAL.CONT.HOOK.INDEX.E.MOOD imperative].


 ;  LEXEME TYPES


verb-lexeme := lexeme & lbl-ltop-lex-item &
  [ SYNSEM.LOCAL.CAT.HEAD verb-all-super,
    SYNSEM.LOCAL.CAT.VAL [ SUBJ < [LOCAL.CONT.HOOK.INDEX #1] >,
                           SPR < >,
                           SPEC <>],
    SYNSEM.LOCAL.CONT.HOOK.XARG #1,
    SYNSEM.LOCAL.CONT.HCONS <! !>,
    SYNSEM.LKEYS.KEYREL event-relation ].

main-verb-lexeme := verb-lexeme &
  [ SYNSEM.LOCAL.CAT.HEAD main-verb & [KEYS.KEY mainverb-key],
    SYNSEM.LOCAL.CAT.VAL [ SUBJ < [LOCAL.CONT.HOOK.INDEX #1] >,
                           SPR < >,
                           SPEC <>],
    SYNSEM.LOCAL.CONT.HOOK.XARG #1,
    SYNSEM.LOCAL.CONT.HCONS <! !>,
    SYNSEM.LKEYS.KEYREL event-relation ].

intr-mainverb-lexeme := main-verb-lexeme  &
  [ SYNSEM intrans-arg1-synsem ].

intr-mainverb-isvc-lexeme := main-verb-lexeme  &
  [ SYNSEM intrans-arg1-isvc-synsem ].


trans-mainverb-lexeme := main-verb-lexeme  &
  [ SYNSEM trans-arg1-2index-synsem,
    BY-DELETION - ].

trans-mainverb-sitobj-lexeme := main-verb-lexeme  &
  [ SYNSEM trans-arg1-2ltop-synsem ].

ditrans-mainverb-lexeme := main-verb-lexeme  &
  [ SYNSEM ditrans-arg1-2-3-synsem,
    BY-DELETION - ].


trans-mainverb-isvc-tr-xtr-long-lexeme := main-verb-lexeme  &
  [ SYNSEM trans-arg1-2-isvc-tr-xtr-synsem ].

trans-mainverb-isvc-tr-xtr-short-lexeme := main-verb-lexeme  &
  [ SYNSEM trans-arg1-2-isvc-tr-xtr-synsem ].

trans-mainverb-isvc-tr-tr-objshare-lexeme := main-verb-lexeme  &
  [ SYNSEM trans-arg1-2-isvc-tr-tr-objshare-synsem ].

trans-mainverb-isvc-tr-tr-objshare-loc-lexeme := main-verb-lexeme  &
  [ SYNSEM trans-arg1-2-isvc-tr-tr-objshare-synsem ].


trans-mainverb-isvc-tr-tr-swtchshare-lexeme := main-verb-lexeme  &
  [ SYNSEM trans-arg1-2-isvc-tr-tr-swtchshare-synsem ].



pre-verb-lexeme := verb-lexeme & 
  [ SYNSEM arg2-comps-synsem & [LOCAL.CAT.HEAD pre-verb],
    SYNSEM.LOCAL.CAT.VAL [ SUBJ < [LOCAL.CONT.HOOK.INDEX #1] >,
                           SPR < >,
                           SPEC <>,
			   COMPS < #2 & [ LOCAL.CAT.HEAD verb-all,
					  LOCAL.CAT.VAL.SUBJ <[]>],... > ],
    SYNSEM.LOCAL.CAT.QVAL.DOBJECT #2,
    SYNSEM.LOCAL.CONT.HOOK.XARG #1,
    SYNSEM.LOCAL.CONT.HCONS <! !>,
    SYNSEM.LKEYS.KEYREL event-relation,
    COMBINED-MAINVB - ].

kE-pre-verb-lexeme := pre-verb-lexeme &
  [ SYNSEM.LOCAL.CAT.VAL [ COMPS < [ LOCAL.CONT.HOOK.LTOP #2,
				     LOCAL.CONT.HOOK.XARG #1 ],... > ],
    SYNSEM.LOCAL.CONT.HOOK.XARG #1,
    SYNSEM.LKEYS.KEYREL arg12-relation & [ARG1 #1,
					  ARG2 #2],
    SYNSEM.EXPNT-PERF -,
    SYNSEM.EXPNT-FUT -,
    SYNSEM.EXPNT-HAB -,
    SYNSEM.EXPNT-PROG -,
    SYNSEM.EXPNT-SBJN -,
    SYNSEM.EXPNT-IMPR - ].

deict-pre-verb-lexeme := pre-verb-lexeme &
  [ SYNSEM.LOCAL.CAT.VAL [ COMPS < [ LOCAL.CONT.HOOK.XARG #1,
    				     EXPNT-PERF -,
    				     EXPNT-FUT +,
    				     EXPNT-HAB + ],... > ],
    SYNSEM.LOCAL.CONT.HOOK.INDEX.E aspmod-prev-deict,
    SYNSEM.LOCAL.CONT.HOOK.XARG #1,
    SYNSEM.LKEYS.KEYREL arg1-relation & [ARG1 #1],
    SYNSEM.EXPNT-PERF +,
    SYNSEM.EXPNT-FUT -,
    SYNSEM.EXPNT-HAB - ].

; hopefully not necessary
;deict-init-preverb-lexeme := deict-pre-verb-lexeme &
;  [ EVC-ASP-INITIATOR + ].
;deict-noninit-preverb-lexeme := deict-pre-verb-lexeme &
;  [ EVC-ASP-INITIATOR - ].

neg-pre-verb-lexeme := pre-verb-lexeme &
  [ SYNSEM.LOCAL.CAT.VAL [ COMPS < [ LOCAL.CONT.HOOK.LTOP #2,
				     LOCAL.CONT.HOOK.XARG #1 ],... > ],
    SYNSEM.LOCAL.CONT.HOOK.INDEX.E aspmod-prev-neg,
    SYNSEM.LOCAL.CONT.HOOK.XARG #1,
    SYNSEM.LKEYS.KEYREL arg1-relation & [ARG1 #2] ].

; hopefully not necessary
;neg-init-preverb-lexeme := neg-pre-verb-lexeme &
;  [ EVC-ASP-INITIATOR + ].
;neg-noninit-preverb-lexeme := neg-pre-verb-lexeme &
;  [ EVC-ASP-INITIATOR - ].



verbid-lexeme := lexeme & reg-mod-lex-item & 
  [ SYNSEM arg2-comps-index-synsem & [LOCAL.CAT.HEAD verbid],
    SYNSEM.LOCAL.CAT.VAL [ SUBJ list,
                           SPR < >,
                           SPEC <>,
			   COMPS <[LOCAL.CAT.HEAD noun ]> ],
    SYNSEM.LOCAL.CONT.HCONS <! !>,
    SYNSEM.LOCAL [ CONT.HOOK.XARG #2 ],
    SYNSEM.LKEYS.KEYREL arg12-relation & [ARG1 #2 ] ].


imperative-verb-lexeme := const-ltol-rule &
  [ C-CONT.RELS <! 2nd-pers-pron-rel & [ARG0 #2,
                                        PRED "second-person-rel",
                                        LBL #3],
                               contextual-q-rel & [ARG0 #2,
                                                   RSTR #4] !>,
    C-CONT.HCONS #8 & <! [HARG #4,
                           LARG #3 ] !>,
    SYNSEM.LOCAL.CONT.HOOK #1, 
    SYNSEM.LOCAL.CONT.HOOK.INDEX.E.MOOD imperative,
    SYNSEM.LOCAL.CONT.HCONS #8,
    SYNSEM.LOCAL.CONT.RELS <! [],[], [] !>,
    SYNSEM.LOCAL.CAT.HEAD #6 & main-verb,
    SYNSEM.LOCAL.CAT.VAL.SPR <>,
    SYNSEM.LOCAL.CAT.VAL.SUBJ cons,
    SYNSEM.LOCAL.CAT.VAL.COMPS #9,
    SYNSEM.LOCAL.CAT.VAL.SPEC <>,
    DTR.SYNSEM.LOCAL.CONT.HOOK #1,
    DTR.SYNSEM.LOCAL.CAT.HEAD #6,
    DTR.SYNSEM.LOCAL.CAT.VAL.SPR <>,
    DTR.SYNSEM.LOCAL.CAT.VAL.SUBJ <[LOCAL.CONT.HOOK.INDEX #2 ]>,
    DTR.SYNSEM.LOCAL.CAT.VAL.COMPS #9 & list,
    DTR.SYNSEM.LOCAL.CAT.VAL.SPEC <>].


noun-lexeme := lbl-ltop-lex-item & lexeme &
  [ SYNSEM.LOCAL.CAT.HEAD noun,
    SYNSEM.LOCAL.CONT.HOOK.INDEX ref-ind,
    SYNSEM.LOCAL.CAT.VAL [ SUBJ <>,
                           SPR list,
                           SPEC list,
                           COMPS <> ],
    SYNSEM.LKEYS.KEYREL noun-relation,
    SYNSEM.LOCAL.CONT.HCONS <! !> ].

pl-noun-lexeme := infl-ltol-rule &
  [ SYNSEM.LOCAL.CAT.HEAD noun,
    SYNSEM.LOCAL.CONT.HOOK.INDEX.PNG pl,
    SYNSEM.LOCAL.CAT.VAL [ SUBJ <>,
                           SPR list,
                           SPEC list,
                           COMPS <> ],
    SYNSEM.LKEYS.KEYREL noun-relation,
    DTR noun-lexeme,
    C-CONT [RELS <! !>,
           HCONS <! !>] ].

adjective-lexeme := reg-mod-lex-item & lexeme &
  [ SYNSEM.LOCAL.CAT [ HEAD adj & [ MOD < [LOCAL.CAT.HEAD noun] >],
                       VAL.COMPS <>,
                       VAL.SUBJ <>,
                       VAL.SPR <>,
                       VAL.SPEC <>],
    SYNSEM.LKEYS.KEYREL adj_rel,
    SYNSEM.LOCAL.CONT.HCONS <! !> ].




; PHRASAL TYPES


imp := non-rel-clause & head-valence-phrase & head-only &
  [ SYNSEM.LOCAL [ CAT [ VAL [ SUBJ olist & < anti-synsem >,
			       SPR olist,
			       COMPS < > ],
			 MC + ] ],
    HEAD-DTR.SYNSEM.LOCAL [ CAT [ HEAD main-verb,
                                  MC na,
                                  VAL [ SUBJ < []  >,
                                        COMPS < > ] ],
                            CONT.HOOK.LTOP #hdtop ],
    HEAD-DTR.SYNSEM.LOCAL.CONT.HOOK.INDEX.E.MOOD imperative,
    C-CONT [ RELS <!  message & [PRED command_m_rel,
                                 MARG #marg ] !>,
             HCONS <! qeq & [ HARG #marg,
                              LARG #hdtop ] !> ] ].





possessive-constr := basic-head-spec-phrase & head-final & rule &
  [ SYNSEM.LOCAL.CONT.HOOK.INDEX #1,
    SYNSEM.LOCAL.CONT.HOOK.XARG #2,
    SYNSEM.LOCAL.CAT.VAL.SPR list,
    HEAD-DTR.SYNSEM.LOCAL.CONT.HOOK.INDEX #1,
    NON-HEAD-DTR.SYNSEM.LOCAL.CONT.HOOK.INDEX #2 & ref-ind,
    NON-HEAD-DTR.SYNSEM.LOCAL.CAT.HEAD noun,
    NON-HEAD-DTR.SYNSEM.LOCAL.CAT.VAL.SPEC <[LOCAL.CONT.HOOK.INDEX #1]>,
    HEAD-DTR.SYNSEM.LOCAL.CAT.VAL.SPR <[]>,
    C-CONT [ RELS <! poss-rel & [ARG1 #2,
				 ARG2 #1] !>,
	     HCONS <! !>]].

head-spec-phrase-super := basic-head-spec-phrase &
  [ SYNSEM.LOCAL.CONT.HOOK.INDEX  #1 & ref-ind,
    SYNSEM.LOCAL.CAT.VAL.SPR list,
    HEAD-DTR.SYNSEM.LOCAL.CONT.HOOK.INDEX #1,
    NON-HEAD-DTR.SYNSEM.LOCAL.CONT.HOOK.INDEX #1,
    C-CONT [ RELS <! !>,
	     HCONS <! !>]].

head-spec-quantor-phrase := head-spec-phrase-super & head-final &
  [ NON-HEAD-DTR.SYNSEM.LOCAL.CAT.HEAD quantor]. 

head-spec-art-phrase := head-spec-phrase-super & head-final &
  [ NON-HEAD-DTR.SYNSEM.LOCAL.CAT.HEAD art]. 

head-spec-card-phrase := head-spec-phrase-super & head-final &
  [ NON-HEAD-DTR.SYNSEM.LOCAL.CAT.HEAD card]. 

head-spec-genitive-posspron-phrase := head-spec-phrase-super & head-final &
  [  NON-HEAD-DTR.SYNSEM.LOCAL.CAT.HEAD posspron].

head-spec-det-phrase := head-spec-phrase-super & head-initial &
  [ NON-HEAD-DTR.SYNSEM.LOCAL.CAT.HEAD det].

head-spec-det-post-phrase := head-spec-phrase-super & head-initial &
  [ NON-HEAD-DTR.SYNSEM.LOCAL.CAT.HEAD det].



;SYNSEM.LOCAL.CONT.MSG #1 & [LBL #2,
;                               MARG #5],
; SYNSEM.LOCAL.CONT.HOOK.LTOP #ltop, ;#2,
      
head-subject-phrase := basic-head-subj-phrase & head-final & rule & 
  [SYNSEM.LOCAL.CONT.HOOK.INDEX #8,
   SYNSEM.LOCAL.CAT.QVAL #qval,
   SYNSEM.LOCAL.GF #gf,
   SYNSEM.LOCAL.INDX #8,
   SYNSEM.LOCAL.ACTNT #act,
   HEAD-DTR.SYNSEM.LOCAL.GF #gf,
   HEAD-DTR.SYNSEM.LOCAL.INDX #8,
   HEAD-DTR.SYNSEM.LOCAL.ACTNT #act,
   HEAD-DTR.SYNSEM.LOCAL.CAT.HEAD verb-all-super & [MOD <>],
   HEAD-DTR.SYNSEM.LOCAL.CAT.VAL.COMPS <>,
;   HEAD-DTR.SYNSEM.LOCAL.CONT.HOOK.LTOP #6,
   HEAD-DTR.SYNSEM.LOCAL.CONT.HOOK.INDEX #8,
;   HEAD-DTR.SYNSEM.LOCAL.CONT.MSG #1,
   HEAD-DTR.INFLECTED +,
   HEAD-DTR.SYNSEM.LOCAL.CAT.QVAL #qval,
   NON-HEAD-DTR.INFLECTED +,
   NON-HEAD-DTR.SYNSEM.LOCAL.CONT.HOOK.INDEX ref-ind,
   NON-HEAD-DTR.SYNSEM.LOCAL.CAT.HEAD noun,
   NON-HEAD-DTR.SYNSEM.LOCAL.CAT.VAL.SPR <>,
   NON-HEAD-DTR.SYNSEM.LOCAL.CAT.VAL.SUBJ <>,
   C-CONT [ RELS <! !>,
            HCONS <! !> ] ].
;   C-CONT [ RELS <! #1 & message & [PRED proposition_m_rel] !>,
;            HCONS <! [HARG #5,
;                      LARG #6 ] !> ] ].


; SYNSEM.LOCAL.CAT.VAL.COMPS olist,
;    
head-verb-comp-phrase := basic-head-comp-phrase & phrasal & head-initial & rule &
  [ SYNSEM.LOCAL.CAT.QVAL #1,
    SYNSEM.EXPNT-FUT #9,
    PREVERB-RESP-DISCHRGD +,
    SYNSEM.LOCAL.GF #gf,
    SYNSEM.LOCAL.INDX #8,
    SYNSEM.LOCAL.ACTNT #act,
    HEAD-DTR.SYNSEM.LOCAL.GF #gf,
    HEAD-DTR.SYNSEM.LOCAL.INDX #8,
    HEAD-DTR.SYNSEM.LOCAL.ACTNT #act,
    HEAD-DTR.SYNSEM.LOCAL.CAT.HEAD verb-all-super,
    HEAD-DTR.SYNSEM.LOCAL.CAT.QVAL #1,
    HEAD-DTR.SYNSEM.EXPNT-FUT #9,
    HEAD-DTR.SYNSEM.LOCAL.CAT.VAL.COMPS <[],...>,
    NON-HEAD-DTR.INFLECTED +,
    NON-HEAD-DTR.SYNSEM.LOCAL.CAT.VAL.SPEC <>,
    NON-HEAD-DTR.SYNSEM.LOCAL.CAT.VAL.COMPS <>,
    NON-HEAD-DTR.SYNSEM.LOCAL.CAT.VAL.SPR <> ].

head-verb-intermedobj-phrase := head-verb-comp-phrase &
  [ SYNSEM.LOCAL.CAT.VAL.COMPS <[]>,
    HEAD-DTR.SYNSEM.LOCAL.CAT.VAL.COMPS <[],[]>,
    NON-HEAD-DTR.SYNSEM.LOCAL.CAT.HEAD noun ].

head-verb-fleximedobj-phrase := head-verb-comp-phrase &
  [ SYNSEM.LOCAL.CAT.VAL.COMPS <[],...>,
    HEAD-DTR.SYNSEM.LOCAL.CAT.VAL.COMPS <[],[],...>,
    NON-HEAD-DTR.SYNSEM.LOCAL.CAT.HEAD noun ].

head-verb-firstof3obj-phrase := head-verb-comp-phrase &
  [ SYNSEM.LOCAL.CAT.VAL.COMPS <[],[]>,
    HEAD-DTR.SYNSEM.LOCAL.CAT.VAL.COMPS <[],[],[]>,
    NON-HEAD-DTR.SYNSEM.LOCAL.CAT.HEAD noun ].

head-verb-lastobj-phrase := head-verb-comp-phrase &
  [ SYNSEM.LOCAL.CAT.VAL.COMPS <>,
    HEAD-DTR.SYNSEM.LOCAL.CAT.VAL.COMPS <[]>,
    NON-HEAD-DTR.SYNSEM.LOCAL.CAT.HEAD noun ].

;head-verb-anyobj-phrase := head-verb-comp-phrase &
;  [ SYNSEM.LOCAL.CAT.VAL.COMPS <...>,
;    HEAD-DTR.SYNSEM.LOCAL.CAT.QVAL.DOBJECT.LOCAL.CONT.HOOK.INDEX #2,
;    HEAD-DTR.SYNSEM.LOCAL.CAT.VAL.COMPS <[LOCAL.CONT.HOOK.INDEX #2],.;..>,
;    NON-HEAD-DTR.SYNSEM.LOCAL.CAT.HEAD noun ].

head-verb-dobj-phrase := head-verb-comp-phrase &
  [ SYNSEM.LOCAL.CAT.VAL.COMPS <>,
;    HEAD-DTR.SYNSEM.LOCAL.CAT.QVAL.DOBJECT.LOCAL.CONT.HOOK.INDEX #2,
;    HEAD-DTR.BY-DELETION -,
    HEAD-DTR.SYNSEM.LOCAL.CAT.QVAL.DOBJECT #4,
    HEAD-DTR.SYNSEM.LOCAL.CAT.VAL.COMPS < #4 & [LOCAL.CONT.HOOK.INDEX semarg,;#2
						LOCAL.CAT.HEAD.MOD <>]>,
    NON-HEAD-DTR.SYNSEM.LOCAL.CAT.HEAD noun ].

head-verb-lastobjDbob-phrase := head-verb-comp-phrase &
  [ HEAD-DTR.SYNSEM.LOCAL.CAT.QVAL.OBJECT2 #2,
    HEAD-DTR.SYNSEM.LOCAL.CAT.VAL.COMPS < #2 >,
    NON-HEAD-DTR.SYNSEM.LOCAL.CAT.HEAD noun ].

head-verb-obl-phrase := head-verb-comp-phrase &
  [ HEAD-DTR.SYNSEM.LOCAL.CAT.QVAL.OBL1.LOCAL.CONT.HOOK.INDEX #2,
    HEAD-DTR.BY-DELETION -,
    HEAD-DTR.SYNSEM.LOCAL.CAT.VAL.COMPS <[LOCAL.CONT.HOOK.INDEX #2]>,
    NON-HEAD-DTR.SYNSEM.LOCAL.CAT.HEAD prep ].

#|
;from norsource:
basic-head-icomp-phrase := head-valence-phrase & head-compositional &
			  binary-headed-phrase & phrasal &
  [ SYNSEM canonical-synsem &
	   [ LOCAL.CAT [ VAL [ SUBJ #subj,
			       COMPS #comps,
			       ICOMPS #icomps,
			       SPR #spr ]],
             NON-LOCAL [ REL 0-dlist ] ],
    SYNSEM.LOCAL.CAT.QVAL #qval,
    SYNSEM.LOCAL.CONT.HOOK.LTOP #ltop,
    HEAD-DTR.SYNSEM.LOCAL.CAT.QVAL #qval,
    HEAD-DTR.SYNSEM.LOCAL.CONT.HOOK.LTOP #ltop,
    HEAD-DTR.SYNSEM [ LOCAL.CAT [ VAL [ SUBJ #subj,
					COMPS #comps,
                                        ICOMPS < #synsem . #icomps >,
                                        SPR #spr ],
				  QVAL.OBL1.LOCAL.CAT.QVAL #dobj] ],
    NON-HEAD-DTR.SYNSEM.LOCAL.CAT.QVAL #dobj,
    NON-HEAD-DTR.SYNSEM #synsem & canonical-synsem,
    C-CONT [ RELS <! !>,
	     HCONS <! !> ] ].
