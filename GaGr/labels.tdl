;;; -*- Mode: TDL; Package: LKB -*-





;;;
;;; LABEL TYPES
;;;

; Not yet treated (July 21):
; obRAISsuMob - involve derivation
; suRAISsuMob - involve derivation
; intrSubcoord - involve multiverbs
; intrPrtclSubcoord - involve multiverbs

;;;
;;; slot 1
;;;

v := v-lex.
vPerf := v & [HEAD.FRMTVS <perf>].
vProg := v & [HEAD.FRMTVS <prog>].
vAor := v & [HEAD.FRMTVS <aor>].
vHab := v & [HEAD.FRMTVS <hab>].
vPass := v & [HEAD.FRMTVS <pass>].
vMidd := v & [HEAD.FRMTVS <middle>].
vAppl := v & [HEAD.FRMTVS <applic>].
vCaus := v & [HEAD.FRMTVS <caus>].

;;;
;;; slot 2
;;;

nullval := nullval-lex.
intr := intr-lex.
intrAdv := intrAdv-lex &
 [ GF.ADV.HEAD adverb ].
intrAdvVid := intrAdv-lex &
 [ GF.ADV.HEAD verb ].
intrImpers := intrImpers-lex.
intrImpersObl := intrImpersObl-lex.
intrImpersComp := intrImpersComp-lex.
intrImpersPrtcl := intrImpersAdv-lex &
 [ GF.ADV.HEAD particle ].
intrImplobj  := intr-lex &
 [ ACTNTS act12-rel ].
intrLoc := intrAdv-lex &
 [ GF.SUBJ.INDX #2,
   GF.ADV.INDX #1,
   ACTNTS loc-rel & [LOC.ACT0 #1,
		     LOC.ACT1 #2]].
intrObl := intrObl-lex.
intrVid := intrObl-lex & [GF.OBL.HEAD verb].
intrOblRais := intrOblRais-lex.
intrPath := intrAdv-lex &
 [ GF.SUBJ.INDX #2,
   GF.ADV.INDX #1,
   ACTNTS dir-rel & [DIR.ACT0 #1,
		     DIR.ACT1 #2]].
intrPresnt := intrPresnt-lex.
intrPresntLoc := intrPresntAdv-lex &
 [ GF.PRES.INDX #2,
   GF.ADV.INDX #1,
   ACTNTS loc-rel & [LOC.ACT0 #1,
		     LOC.ACT1 #2]].
intrPresntPath := intrPresntAdv-lex &
 [ GF.PRES.INDX #2,
   GF.ADV.INDX #1,
   ACTNTS dir-rel & [DIR.ACT0 #1,
		     DIR.ACT1 #2]].
intrPrtcl := intrAdv-lex &
 [ GF.ADV.HEAD particle ].
intrPrtclObl := intrAdvObl-lex &
 [ GF.ADV.HEAD particle ].
intrScpr := intrScpr-lex.
intrLghtScpr := intrScpr-lex.
intrScprObl := intrScprObl-lex.
intrLghtScprObl := intrScprObl.
intrLghtScprVid := intrScprObl & [GF.OBL.HEAD verb].
intrScprVid := intrScprObl & [GF.OBL.HEAD verb].
intrExpn := intrExpn-lex.
intrOblExpn := intrOblExpn-lex.
intrPrtclExpn := intrAdvExpn-lex.
intrOblExlnk := intrOblExlnk-lex.
intrPrtclOblExlnk := intrAdvOblExlnk-lex.
intrPrtclOblRais := intrAdvOblRais-lex.
intrComp := intrComp-lex.
intrAuxperfScpr := intrScpr & [HEAD perfaux].
intrAuxmodScpr := intrScpr & [HEAD modaux].
intrAuxmodComp := intrComp & [HEAD modaux].
intrImpltransfAdv := intrImpltransfAdv-lex.  

tr := tr-lex.
trImpers := trImpers-lex.
trImpersComp := trImpersComp-lex.
trObl := trObl-lex.
trAdv := trAdv-lex.
trPrtcl := trAdv-lex &
 [ GF.ADV.HEAD particle ].
trScpr := trScpr-lex.
; claim: when a trans verb has a path const, the obj is always directed relative to that path-adv. The subject may be too, but always the object.
trPath := trAdv-lex &
 [ GF.OBJ.INDX #2,
   GF.ADV.INDX #1,
   ACTNTS dir-rel & [DIR.ACT0 #1,
		     DIR.ACT1 #2]].
trPresnt := trPresnt-lex.  
trExpnSu := trExpnSu-lex.  
trExpnOb := trExpnOb-lex.  
trNrfExpnSu := trNrfExpnSu-lex.
trNrf := trNrf-lex.
; in the valence slot for scpr, nothing is generally said about linking and reference - comes in slot 3. 
trNrfScpr := trScpr.
trComp := trComp-lex. 
trLght := tr & [GF.OBJ.INDX.ROLE theme-abstr].
trVid := trObl-lex & [GF.OBL.HEAD verb].  
trLghtVid := trVid & [GF.OBJ.INDX.ROLE theme-abstr]. 

ditr := ditr-lex.
dbob := dbob-lex.
ditrObl := ditrObl-lex.
dbobObl := dbobObl-lex.
ditrNrf := ditrNrf-lex. 
ditrVid := ditrObl & [GF.OBL.HEAD verb].
dbobVid := dbobObl & [GF.OBL.HEAD verb].
ditrExpnSu := ditrExpnSu-lex.  

trCs := trCs-lex.
ditrCs := ditrCs-lex.
dbobCs := dbobCs-lex.
tritr := tritr-lex.
qtrtr := qtrtr-lex.
; should be decomposed:
;trOblCs-oblCsu-lex
;trOblCs-obCsu-lex

copPred := copPred-lex.
copAdj := copPred & [GF.SCPR.HEAD adjective]. 
copAdv := copPred & [GF.SCPR.HEAD adverb]. 
copN := copPred & [GF.SCPR.HEAD noun].  
copPP := copPred & [GF.SCPR.HEAD prep].  
copPredprtcl := copPred & [GF.SCPR.HEAD predparticle]. 
coplocAdj := copAdj & [GF.SUBJ.INDX.ROLE located-obj]. 
coplocAdv := copAdv & [GF.SUBJ.INDX.ROLE located-obj]. 
copId := copId-lex. 
copIdN := copId &  [GF.IDNT.HEAD noun].
copIdAbsinf := copId &  [GF.IDNT.HEAD infmark]. 
copIdDECL := copId &  [GF.IDNT.MODE decl].  
copIdYN := copId &  [GF.IDNT.MODE yn-interr].  
copIdWH := copId &  [GF.IDNT.MODE wh-interr].  
copExpn := copExpn-lex.
copExpnAdj := copExpn & [GF.SCPR.HEAD adjective].  
copExpnN := copExpn & [GF.SCPR.HEAD noun].  
copExpnPP := copExpn & [GF.SCPR.HEAD prep].  
copExpnPredprtcl := copExpn & [GF.SCPR.HEAD predparticle].  

lghtAdj := intrLghtScpr & [GF.SCPR.HEAD adjective].  
lghtAdv := intrLghtScpr & [GF.SCPR.HEAD adverb].  
lghtAdjVid := intrLghtScprVid & [GF.SCPR.HEAD adjective].
lghtN := intrLghtScpr & [GF.SCPR.HEAD noun].  

intrScprPrtcl := intrScprAdv-lex &
 [ GF.ADV.HEAD particle ].
intrPrtclScpr := intrAdvScpr-lex &
 [ GF.ADV.HEAD particle ].
trNrfAdv := trNrfAdv-lex.
trNrfComp := trNrfComp-lex.
trNrfObl := trNrfObl-lex.
trNrfPath := trNrfAdv &
 [ GF.SUBJ.INDX #2,
   GF.ADV.INDX #1,
   ACTNTS dir-rel & [DIR.ACT0 #1,
		     DIR.ACT1 #2]].

trNrfPresnt := trNrfPresnt-lex.
trNrfPresntAdv := trNrfPresntAdv-lex.
trNrfPresntPath := trNrfPresntAdv &
 [ GF.PRES.INDX #2,
   GF.ADV.INDX #1,
   ACTNTS dir-rel & [DIR.ACT0 #1,
		     DIR.ACT1 #2]].
trNrfPresntLoc := trNrfPresntAdv &
 [ GF.PRES.INDX #2,
   GF.ADV.INDX #1,
   ACTNTS loc-rel & [LOC.ACT0 #1,
		     LOC.ACT1 #2]].
trNrfPrtcl := trNrfAdv & [ GF.ADV.HEAD particle ].
trScprShft := trScprShft-lex.
copImpersAdv := copImpersAdv-lex.
; "for x to be in Finnmark is fine"
copImpersAdjLoc := copImpersAdv &
 [ GF.SCPR.HEAD adjective,
   ACTNTS.ACT1.KIND loc-rel & [ LOC.ACT1.ROLE located-obj]].

#|
axv_intr-av1mod-scThsit
axv_intr-av1perf
axv_intrPs-av1pass
axv_intrPs-av1mod-av2perf-av3pass
axv_rootmod-intr
|#

;;;
;;; slot 1+2
;;;


v-intr := v & intr.
vPerf-intr := vPerf & intr.

;;;
;;; slot 3
;;;

;; su
suExpl := subj-sign. 
suDir := sign & [GF.SUBJ.INDX.ROLE orientedobj].
suDECL := sign & [GF.SUBJ.MODE decl]. 
suYN := sign & [GF.SUBJ.MODE yn-interr].  
suWH := sign & [GF.SUBJ.MODE wh-interr].  
suInf := sign & [GF.SUBJ.HEAD infmark].  
suGer := sign & [GF.SUBJ.TENSE gerund].  
suAbsinf := sign & [GF.SUBJ.HEAD infmark].  
suNrg := subj-sign.
suSM := sign & [HEAD.SM #1,
		GF.SUBJ.HEAD.AGR #1 & agr & [TARGTD +]].
suAgr := sign & [HEAD.SM #1,
		 GF.SUBJ.HEAD.AGR #1 & agr & [TARGTD +]].
suAgraux := sign & [HEAD auxverb & [SM #1],
		    GF.SUBJ.HEAD.AGR #1 & agr & [TARGTD +]]. 
suAgrsc := sign & [GF.SCPR.HEAD.SM #1,
		   GF.SUBJ.HEAD.AGR #1 & agr & [TARGTD +]].  
suNom := sign & [GF.SUBJ.HEAD.CASE nominative].  
suAcc := sign & [GF.SUBJ.HEAD.CASE accusative]. 
suGen := sign & [GF.SUBJ.HEAD.CASE genitive].  
suDat := sign & [GF.SUBJ.HEAD.CASE dative].  
suErg := sign & [GF.SUBJ.HEAD.CASE ergative].
suAbsl := sign & [GF.SUBJ.HEAD.CASE absolutive].
suAbl := sign & [GF.SUBJ.HEAD.CASE ablative].
suClit := sign & [GF.SUBJ.HEAD.REAL clitic]. 
suDrop := sign & [GF.SUBJ.HEAD.REAL drop].  
suNul := sign & [GF.SUBJ.HEAD.REAL nul].  
; the subject is a poss-phrase:
suPossp := sign & [GF.SUBJ poss-lex].
; the subject is a postpos-phrase:
suPostp := sign & 
	[GF.SUBJ poss-lex &
	[ ACTNTS.PRED spatial-coord_rel]]. 
; the subject's specifier is a poss-phrase:
suSpecPossp := sign & 
	[GF.SUBJ poss-lex &
	[ GF.SPEC poss-lex]].
; the subject's specifier is a postpos-phrase:
suSpecPostp := sign & 
	[GF.SUBJ poss-lex &
	[ GF.SPEC poss-lex & [ACTNTS.PRED spatial-coord_rel]]]. 
; the subject is a postpos-phrase with a poss-phrase as spec:
suPostpSpecPossp := suSpecPossp & 
	[GF.SUBJ.ACTNTS.PRED spatial-coord_rel].
suBPsuSpec := sign & 
	[GF.SUBJ poss-lex &
	[ ACTNTS.PRED bodypart_rel]].
suBPspec := suBPsuSpec. 
; the subject is a postpositional phrase and the specifier of its specifier is in a body-bodypart relation to the specifier (literal ex: "his head's edge"):
suPostpSpecBP := sign & [GF.SUBJ poss-lex &
	[ ACTNTS.PRED spatial-coord_rel,
	  GF.SPEC poss-lex & [ACTNTS.PRED bodypart_rel]]].
; the subject's specifier is a bodypart of the subject's specifier's specifier ("his head's edge") - same as suPostpSpecBP, except for leaving open the highest spec-head relation:
suSpecBPspec := sign & 
	[GF.SUBJ poss-lex &
	[ GF.SPEC poss-lex & [ACTNTS.PRED bodypart_rel]]].
suIDobSpec := sign & [GF.SUBJ.INDX #1,
		      GF.OBJ.GF.SPEC.INDX #1]. 
suSpecIDob := sign & [GF.SUBJ.GF.SPEC.INDX #1,
		          GF.OBJ.INDX #1]. 
suSpecIDobSpec := sign & [GF.SUBJ.GF.SPEC.INDX #1,
		          GF.OBJ.GF.SPEC.INDX #1]. 
suIDobSu := sign & [GF.SUBJ.INDX #1,
		    GF.OBJ.GF.SUBJ.INDX #1]. 
suIDiobSpec := sign & [GF.SUBJ.INDX #1,
		      GF.IOBJ.GF.SPEC.INDX #1]. 
suIDobSpecSpec := sign & 
		[GF.SUBJ.INDX #1,
		GF.OBJ.GF.SPEC.GF.SPEC.INDX #1]. 
suIDob2SpecSpec := sign & 
		[GF.SUBJ.INDX #1,
		GF.OBJ2.GF.SPEC.GF.SPEC.INDX #1]. 
suIDcompSu := sign & [GF.SUBJ.INDX #1,
		      GF.COMP.GF.SUBJ.INDX #1]. 
suIDexpnSu := sign & [GF.SUBJ.INDX #1,
		      GF.EXPN.GF.SUBJ.INDX #1]. 
obIDexpnOb := sign & [GF.OBJ.INDX #1,
		      GF.EXPN.GF.OBJ.INDX #1]. 
 suUnif := sign & [ACTNTS.PRED unif-su_rel]. 

;; ob
obArg := obj-act2-link.
obNrg := obj-sign.
obDir := sign &
 [ GF.OBJ.INDX.ROLE orientedobj ].
obPro := sign & [ GF.OBJ.HEAD.REAL nul ].
obNul := sign & [ GF.OBJ.HEAD.REAL nul ].
obRefl := sign & [ GF.OBJ.HEAD refl ]. 
obReflExpl := sign & [ GF.OBJ.HEAD refl ].	
obDECL := sign & [GF.OBJ.MODE decl]. 
obDECLcmp := sign & [GF.OBJ.MODE decl,
		     GF.OBJ.HEAD decl-compltzr]. 
obDECLbare := sign & [GF.OBJ.MODE decl,
		     GF.OBJ.HEAD verb].   
obIRR := sign & [GF.OBJ.MODE irrealis].  
obIRRcmp := sign & [GF.OBJ.MODE irrealis,
		     GF.OBJ.HEAD compltzr].  
obIRRbare := sign & [GF.OBJ.MODE irrealis,
		     GF.OBJ.HEAD verb].  
obYN := sign & [GF.OBJ.MODE yn-interr].  
obWH := sign & [GF.OBJ.MODE wh-interr].  
obOM := sign & [HEAD.OM #1,
		GF.OBJ.HEAD.AGR #1 & agr & [TARGTD +]].  
obAgrsc := sign & [GF.SCPR.HEAD.SM #1,
		   GF.OBJ.HEAD.AGR #1 & agr & [TARGTD +]].  
obAcc := sign & [GF.OBJ.HEAD.CASE accusative].  
obGen := sign & [GF.OBJ.HEAD.CASE genitive].  
obDat := sign & [GF.OBJ.HEAD.CASE dative].  
obNom := sign & [GF.OBJ.HEAD.CASE nominative].  
obAbsl := sign & [GF.OBJ.HEAD.CASE absolutive].  
obErg := sign & [GF.OBJ.HEAD.CASE ergative].  
obDef := sign & [GF.OBJ.HEAD.DEF +].  
obIndef := sign & [GF.OBJ.HEAD.DEF -].  
obAccDef := sign & [GF.OBJ.HEAD.CASE accusative,
		    GF.OBJ.HEAD.DEF +].  
obAccIndef := sign & 
	[GF.OBJ.HEAD.CASE accusative,
	GF.OBJ.HEAD.DEF -].  
obAccDefOM := sign & 
	[HEAD.OM #1,
	GF.OBJ.HEAD.AGR #1 & agr & [TARGTD +],
	GF.OBJ.HEAD.CASE accusative,
	GF.OBJ.HEAD.DEF +].   
obClit := sign & [GF.OBJ.HEAD.REAL clitic].  
obDrop := sign & [GF.OBJ.HEAD.REAL drop].  
obPossp := sign & [GF.OBJ poss-lex].  
obPostp := sign & 
	[GF.OBJ poss-lex &
	[ ACTNTS.PRED spatial-coord_rel]].  
obSpecPossp := sign & 
	[GF.OBJ poss-lex &
	[ GF.SPEC poss-lex]].  
obSpecPostp := sign & 
	[GF.OBJ poss-lex &
	[ GF.SPEC poss-lex & [ACTNTS.PRED spatial-coord_rel]]].  
obPostpSpecPossp := obSpecPossp & 
	[GF.OBJ.ACTNTS.PRED spatial-coord_rel].  
obBPobSpec:= sign & 
	[GF.OBJ poss-lex &
	[ ACTNTS.PRED bodypart_rel]].
obBPspec := obBPobSpec. 
obPostpSpecBP := sign & [GF.OBJ poss-lex &
	[ ACTNTS.PRED spatial-coord_rel,
	  GF.SPEC poss-lex & [ACTNTS.PRED bodypart_rel]]].  
obBPsu := sign &
	[GF.OBJ.INDX #1,
	GF.SUBJ.INDX #2,
	ACTNTS.PRED bodypart_rel,
	ACTNTS.ACT1 #2,
	ACTNTS.ACT2 #1]. 
obPRTOFsu := sign &
	[GF.OBJ.INDX #1,
	GF.SUBJ.INDX #2,
	ACTNTS.PRED part-of_rel,
	ACTNTS.ACT1 #2,
	ACTNTS.ACT2 #1]. 
obUnif := sign & [ACTNTS.PRED unif-ob_rel].  
obNomvL := sign & [GF.OBJ.HEAD nomverb]. 
obSpecNomvL := sign & [GF.OBJ.GF.SPEC.HEAD nomverb]. 
obIDsuSpec := sign & [GF.OBJ.INDX #1,
		      GF.SUBJ.GF.SPEC.INDX #1].  
  
obIDexpnSu := sign & [GF.OBJ.INDX #1,
		      GF.EXPN.GF.SUBJ.INDX #1].
obSpecIDvidObSpec := sign & 
	[GF.OBJ.GF.SPEC.INDX #1,
	 GF.OBL.GF.GOV.GF.SPEC.INDX #1,
	 GF.OBL.HEAD verb]. 
obIDvidObSpec := sign & 
	[GF.OBJ.INDX #1,
	 GF.OBL.GF.GOV.GF.SPEC.INDX #1,
	 GF.OBL.HEAD verb]. 

obEqInf := sign & [GF.SUBJ.INDX #1,
		   GF.OBJ.GF.SUBJ.INDX #1,
		   GF.OBJ.HEAD infmark]. 
obEqSuInf := sign & [GF.SUBJ.INDX #1,
		   GF.OBJ.GF.SUBJ.INDX #1,
		   GF.OBJ.HEAD infmark]. 
obEqIobInf := sign & [GF.IOBJ.INDX #1,
		   GF.OBJ.GF.SUBJ.INDX #1,
		   GF.OBJ.HEAD infmark]. 
obEqBareinf := sign & [GF.SUBJ.INDX #1,
		   GF.OBJ.GF.SUBJ.INDX #1,
		   GF.OBJ.HEAD verb,
		   GF.OBJ.TENSE infin]. 
obEqSuBareinf := sign & [GF.SUBJ.INDX #1,
		   GF.OBJ.GF.SUBJ.INDX #1,
		   GF.OBJ.HEAD verb,
		   GF.OBJ.TENSE infin]. 
obEqIobBareinf := sign & [GF.IOBJ.INDX #1,
		   GF.OBJ.GF.SUBJ.INDX #1,
		   GF.OBJ.HEAD verb,
		   GF.OBJ.TENSE infin]. 
obAbsInf := sign & [GF.OBJ.HEAD infmark]. 
obAspIDvAsp := sign & [ ASPECT #1,
			GF.OBJ.ASPECT #1]. 
iobReflExpl := sign & [GF.IOBJ.HEAD refl].  
iobPro := sign & [ GF.IOBJ.HEAD.REAL nul ].
iobRefl := sign & [ GF.IOBJ.HEAD refl ]. 
iobAcc := sign & [GF.IOBJ.HEAD.CASE accusative].  
iobGen := sign & [GF.IOBJ.HEAD.CASE genitive].  
iobDat := sign & [GF.IOBJ.HEAD.CASE dative].  
iobNom := sign & [GF.IOBJ.HEAD.CASE nominative].  
iobAbsl := sign & [GF.IOBJ.HEAD.CASE absolutive].  
iobErg := sign & [GF.IOBJ.HEAD.CASE ergative].  
iobDef := sign & [GF.IOBJ.HEAD.DEF +].  
iobIndef := sign & [GF.IOBJ.HEAD.DEF -].  
iobAccDef := sign & [GF.IOBJ.HEAD.CASE accusative,
		    GF.IOBJ.HEAD.DEF +].  
iobAccIndef := sign & 
	[GF.IOBJ.HEAD.CASE accusative,
	GF.IOBJ.HEAD.DEF -].  
iobAccDefOM := sign & 
	[HEAD.OM #1,
	GF.IOBJ.HEAD.AGR #1 & agr & [TARGTD +],
	GF.IOBJ.HEAD.CASE accusative,
	GF.IOBJ.HEAD.DEF +].   
iobClit := sign & [GF.IOBJ.HEAD.REAL clitic].  
iobDrop := sign & [GF.IOBJ.HEAD.REAL drop].  
iobOM := sign & [HEAD.OM #1,
		GF.IOBJ.HEAD.AGR #1 & agr & [TARGTD +]].  
iobPossp := sign & [GF.IOBJ poss-lex].  
iobPostp := sign & 
	[GF.IOBJ poss-lex &
	[ ACTNTS.PRED spatial-coord_rel]].  

ob2OM := sign & [HEAD.OM #1,
		GF.OBJ2.HEAD.AGR #1 & agr & [TARGTD +]].  
ob2Acc := sign & [GF.OBJ2.HEAD.CASE accusative].  
ob2Gen := sign & [GF.OBJ2.HEAD.CASE genitive].  
ob2Dat := sign & [GF.OBJ2.HEAD.CASE dative].  
ob2Clit := sign & [GF.OBJ2.HEAD.REAL clitic].  
ob2Drop := sign & [GF.OBJ2.HEAD.REAL drop].  
ob2Unif := sign & [ACTNTS.PRED unif-ob_rel].  
ob2AccDef := sign & [GF.OBJ2.HEAD.CASE accusative,
		    GF.OBJ2.HEAD.DEF +].  
ob2AccIndef := sign & 
	[GF.OBJ2.HEAD.CASE accusative,
	GF.OBJ2.HEAD.DEF -].  
ob2AccDefOM := sign & 
	[HEAD.OM #1,
	GF.OBJ2.HEAD.AGR #1 & agr & [TARGTD +],
	GF.OBJ2.HEAD.CASE accusative,
	GF.OBJ2.HEAD.DEF +].   
ob2DatDef := sign & [GF.OBJ2.HEAD.CASE dative,
		    GF.OBJ2.HEAD.DEF +].  
ob2DatIndef := sign & [GF.OBJ2.HEAD.CASE dative,
		    GF.OBJ2.HEAD.DEF -].   
ob2DatDefOM := sign & [HEAD.OM #1,
	GF.OBJ.HEAD.AGR #1 & agr & [TARGTD +],
	GF.OBJ2.HEAD.CASE dative,
		    GF.OBJ2.HEAD.DEF +].  
ob2DECLcmp := sign & [GF.OBJ2.MODE decl,
		     GF.OBJ2.HEAD decl-compltzr]. 
ob2DECL := sign & [GF.OBJ2.MODE decl]. 
ob2SpecPostp := sign & 
	[GF.OBJ2 poss-lex &
	[ GF.SPEC poss-lex & [ACTNTS.PRED spatial-coord_rel]]].  
ob3OM := sign & [HEAD.OM #1,
		GF.OBJ3.HEAD.AGR #1 & agr & [TARGTD +]].  
ob3Acc := sign & [GF.OBJ3.HEAD.CASE accusative].  
ob3Gen := sign & [GF.OBJ3.HEAD.CASE genitive].  
ob3Dat := sign & [GF.OBJ3.HEAD.CASE dative].  
ob3Clit := sign & [GF.OBJ3.HEAD.REAL clitic].  
ob3Drop := sign & [GF.OBJ3.HEAD.REAL drop].  
ob4OM := sign & [HEAD.OM #1,
		GF.OBJ4.HEAD.AGR #1 & agr & [TARGTD +]].  
ob4Clit := sign & [GF.OBJ4.HEAD.REAL clitic].  
ob4Drop := sign & [GF.OBJ4.HEAD.REAL drop].  

oblRefl := sign & [GF.OBL.GF.GOV.HEAD refl].  
oblOM := sign & [HEAD.OM #1,
		 GF.OBL.GF.GOV.HEAD.AGR #1 & agr & [TARGTD +]].
oblDECL := sign & [GF.OBL.GF.GOV.MODE decl].
oblYN := sign & [GF.OBL.GF.GOV.MODE yn-interr].  
oblWH := sign & [GF.OBL.GF.GOV.MODE wh-interr].  
oblAbsinf := sign & [GF.OBL.GF.GOV.HEAD infmark].  
oblEqSuInf := sign & [GF.SUBJ.INDX #1,
		      GF.OBL.GF.GOV.GF.SUBJ.INDX #1,
		      GF.OBL.GF.GOV.HEAD infmark].  
oblEqObInf := sign & [GF.OBJ.INDX #1,
		      GF.OBL.GF.GOV.GF.SUBJ.INDX #1,
		      GF.OBL.GF.GOV.HEAD infmark].  
oblRaisInf := sign & [GF.SUBJ.INDX #1,
		      GF.OBL.GF.GOV.GF.SUBJ.INDX #1,
		      GF.OBL.GF.GOV.HEAD infmark]. 
oblBPsu := sign &
	[GF.OBL.GF.GOV.INDX #1,
	GF.SUBJ.INDX #2,
	ACTNTS.PRED bodypart_rel,
	ACTNTS.ACT1 #2,
	ACTNTS.ACTobl #1]. 
oblBPob := sign &
	[GF.OBL.GF.GOV.INDX #2,
	GF.OBJ.INDX #1,
	ACTNTS.PRED bodypart_rel,
	ACTNTS.ACT2 #1,
	ACTNTS.ACTobl #2]. 
oblBPiob := sign &
	[GF.OBL.GF.GOV.INDX #1,
	GF.IOBJ.INDX #2,
	ACTNTS.PRED bodypart_rel,
	ACTNTS.ACT3 #2,
	ACTNTS.ACTobl #1]. 

oblExlnkAbsinf := sign & [GF.OBL.GF.GOV.HEAD infmark]. 
oblExlnkDECL := sign & [GF.OBL.GF.GOV.MODE decl]. 
advRefl := sign & [GF.ADV.GF.GOV.HEAD refl].  

compEqBareinf := sign & [GF.SUBJ.INDX #1,
		   GF.COMP.GF.SUBJ.INDX #1,
		   GF.COMP.HEAD verb,
		   GF.COMP.TENSE infin]. 
