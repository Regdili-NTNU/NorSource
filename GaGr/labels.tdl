;;; Serial verbs

sv := feat-struc &
 [ V1 v-sign,
   V2 v-sign ].
sv3 := sv &
 [ V3 v-sign ].
sv4 := sv3 &
 [ V4 v-sign ].
svSuID := sv &
 [ V1.GF.SUBJ #1,
   V2.GF.SUBJ #1 ].
sv3suID := sv3 & svSuID &
 [ V2.GF.SUBJ #1,
   V3.GF.SUBJ #1 ].
sv4suID := sv4 & sv3suID &
 [ V3.GF.SUBJ #1,
   V4.GF.SUBJ #1 ].
svObID := sv &
 [ V1.GF.OBJ #1,
   V2.GF.OBJ #1 ].
sv3obID := sv3 & svObID &
 [ V2.GF.OBJ #1,
   V3.GF.OBJ #1 ].
sv4obID := sv4 & sv3obID &
 [ V3.GF.OBJ #1,
   V4.GF.OBJ #1 ].
svAspID := sv &
 [ V1.ASPECT #1,
   V2.ASPECT #1 ].
sv3aspID := sv3 & svAspID &
 [ V2.ASPECT #1,
   V3.ASPECT #1 ].
sv4aspID := sv4 & sv3aspID &
 [ V3.ASPECT #1,
   V4.ASPECT #1 ].
svsuObID := svSuID & svObID.
sv3suObID := sv3suID & sv3obID.
sv4suObID := sv4suID & sv4obID.
;sv_suAspID := svSuID & svAspID.
svSuAspID := svSuID & svAspID.
sv3_suAspID := sv3suID & sv3aspID.
sv4_suAspID := sv4suID & sv4aspID.
svSuObAspID := svSuObID & svAspID.
sv3suObAspID := sv3suObID & sv3aspID.
sv4suObAspID := sv4suObID & sv4aspID.

v1intr := sv &
 [ V1 v-intr-sign ].
v2intr := sv &
 [ V2 v-intr-sign ].
v3intr := sv3 &
 [ V3 v-intr-sign ].
v4intr := sv4 &
 [ V4 v-intr-sign ].
v1tr := sv &
 [ V1 v-tr-sign ].
v2tr := sv &
 [ V2 v-tr-sign ].
v3tr := sv3 &
 [ V3 v-tr-sign ].
v4tr := sv4 &
 [ V4 v-tr-sign ].
v1ditr := sv &
 [ V1 v-ditr-sign ].
v2ditr := sv &
 [ V2 v-ditr-sign ].
v3ditr := sv3 &
 [ V3 v-ditr-sign ].
v4ditr := sv4 &
 [ V4 v-ditr-sign ].
v1dbob := sv &
 [ V1 v-dbob-sign ].
v2dbob := sv &
 [ V2 v-dbob-sign ].
v3dbob := sv3 &
 [ V3 v-dbob-sign ].
v4dbob := sv4 &
 [ V4 v-dbob-sign ].

v1obTh := sv & [ V1.GF.OBJ.INDX.ROLE theme ].
v1obEndpt := sv & [ V1.GF.OBJ.INDX.ROLE endpnt ].
v2suClit := sv & [ V2.GF.SUBJ.HEAD.REAL clitic ].
v2obBen := sv & [ V2.GF.OBJ.INDX.ROLE beneficiary ].
v2iobBen := sv & [ V2.GF.IOBJ.INDX.ROLE beneficiary ].
v2obEndpnt := sv & [ V2.GF.OBJ.INDX.ROLE endpnt ].
v2obEndpt := sv & [ V2.GF.OBJ.INDX.ROLE endpnt ].
v2obPro := sv & [ V2.GF.OBJ.HEAD.REAL nul ].
v2obThmover := sv & [ V2.GF.OBJ.INDX.ROLE theme-mover ].
v1obThmover := sv & [ V1.GF.OBJ.INDX.ROLE theme-mover ].
v2ob2Endpt := sv & [ V2.GF.OBJ2.INDX.ROLE endpnt ].
v1obContent := sv & [ V1.GF.OBJ.INDX.ROLE content ].
v2obTh := sv & [ V2.GF.OBJ.INDX.ROLE theme ].
v2obRec := sv & [ V2.GF.OBJ.INDX.ROLE recipient ].
v2iobRec := sv & [ V2.GF.IOBJ.INDX.ROLE recipient ].
v1obLocus := sv & [ V1.GF.OBJ.INDX.ROLE locus ].
v1obPostp := sv & [ V1.GF.OBJ.ACTNTS.PRED spatial-coord_rel].
v1obSpecIDv2ob := sv & [ V1.GF.OBJ.GF.SPEC.INDX #1,
			V2.GF.OBJ.INDX #1].
v1obThAbst := sv & [ V1.GF.OBJ.INDX.ROLE theme-abstr ].
v1suIDobSpec := sv & [ V1.GF.SUBJ.INDX #1,
			V2.GF.OBJ.GF.SPEC.INDX #1].
v2obTrgt := sv & [ V2.GF.OBJ.INDX.ROLE target ].

;;;;;;;;;;;;;;;;;;;;;;;;

;;; Extended verb complexes (EVC, EV, ev)
; the EVC itself, classified according to how many preverbs it has (3 is max)
ev := v-sign &
 [ PV1 v-sign & [GF.SUBJ #1],
   GF.SUBJ #1 ].
ev2 := ev &
 [ PV2 v-sign & [GF.SUBJ #1],
   GF.SUBJ #1 ].
ev3 := ev2 &
 [ PV3 v-sign & [GF.SUBJ #1],
   GF.SUBJ #1 ].
pv1tr := ev & [ PV1 v-tr-sign ].
pv1obEventunit := pv1tr & [PV1.GF.OBJ.INDX.ROLE eventunit].
pv1obNul := pv1tr & [PV1.GF.OBJ.HEAD.REAL nul ].
pv1obPro := pv1tr & [PV1.GF.OBJ.HEAD.REAL nul ].
pv1obNomvL := pv1tr & [PV1.GF.OBJ.HEAD nomverb ].
pv1obPossp := pv1tr & [PV1.GF.OBJ poss-lex].
pv1obPostp := pv1tr & [PV1.GF.OBJ poss-lex &
			[ ACTNTS.PRED spatial-coord_rel]].
pv1obBPspec := pv1tr & [PV1.GF.OBJ poss-lex &
			[ ACTNTS.PRED bodypart_rel]].
pv1suIDpv1obSpec := pv1tr & [PV1.GF.SUBJ.INDX #1,
				PV1.GF.OBJ.GF.SPEC.INDX #1].
pv1obTh := pv1tr & [PV1.GF.OBJ.INDX.ROLE theme].
pv1obInstr := pv1tr & [PV1.GF.OBJ.INDX.ROLE instr].
pv1obInstrsit := pv1tr & [PV1.GF.OBJ.INDX.ROLE instrsit].
pv1obThsit := pv1tr & [PV1.GF.OBJ.INDX.ROLE theme-sit].

vintr := ev & v-intr-sign.
vtr := ev & v-tr-sign.
vditr := ev & v-ditr-sign.

; for cases where a verb in a series is an EVC
v1ev := sv &
 [ V1 ev ].
v2ev := sv &
 [ V2 ev ].
v3ev := sv3 &
 [ V3 ev ].
v4ev := sv4 &
 [ V4 ev ].

; for each preverb inside serial verb nr. 1, whether it is intr or tr
v1pv1intr := v1ev &
 [ V1.PV1 v-intr-sign ].
v1pv1tr := v1ev &
 [ V1.PV1 v-tr-sign ].
v1pv2intr := v1ev &
 [ V1.PV2 v-intr-sign ].
v1pv2tr := v1ev &
 [ V1.PV2 v-tr-sign ].
v1pv3intr := v1ev &
 [ V1.PV3 v-intr-sign ].
v1pv3tr := v1ev &
 [ V1.PV3 v-tr-sign ].

; for each preverb inside serial verb nr. 2, whether it is intr or tr
v2pv1intr := v2ev &
 [ V2.PV1 v-intr-sign ].
v2pv1tr := v2ev &
 [ V2.PV1 v-tr-sign ].
v2pv2intr := v2ev &
 [ V2.PV2 v-intr-sign ].
v2pv2tr := v2ev &
 [ V2.PV2 v-tr-sign ].
v2pv3intr := v2ev &
 [ V2.PV3 v-intr-sign ].
v2pv3tr := v2ev &
 [ V2.PV3 v-tr-sign ].

; for each preverb inside serial verb nr. 3, whether it is intr or tr
v3pv1intr := v3ev &
 [ V3.PV1 v-intr-sign ].
v3pv1tr := v3ev &
 [ V3.PV1 v-tr-sign ].
v3pv2intr := v3ev &
 [ V3.PV2 v-intr-sign ].
v3pv2tr := v3ev &
 [ V3.PV2 v-tr-sign ].
v3pv3intr := v3ev &
 [ V3.PV3 v-intr-sign ].
v3pv3tr := v3ev &
 [ V3.PV3 v-tr-sign ].
; there could be more Vs in a series, and so need for specifying in the same style for V4, V5 etc.

v1pv1suAg := v1ev &
 [ V1.PV1.GF.SUBJ.INDX.ROLE agent ].
v2pv1obPro := v2ev &
 [ V2.PV1.GF.OBJ.HEAD.REAL nul ].
v2pv1obThsit := v2ev &
 [ V2.PV1.GF.OBJ.INDX.ROLE theme-sit ].




; now defining for the main verb inside an EVC what valence it has, and thus the whole EVC as such relative to its environment
ev_intr := ev & v-intr-sign.
ev2_intr := ev_intr & ev2.
ev3_intr := ev2_intr & ev3.
ev_tr := ev & v-tr-sign.
ev2_tr := ev_tr & ev2.
ev3_tr := ev2_tr & ev3.
ev_ditr := ev & v-ditr-sign.
ev2_ditr := ev_ditr & ev2.
ev3_ditr := ev2_ditr & ev3.
; applying the above to v1 in a series
v1_ev_intr := v1intr &
 [ V1 ev_intr ].
v1_ev2_intr := v1intr &
 [ V1 ev2_intr ].
v1_ev3_intr := v1intr &
 [ V1 ev3_intr ].
v1_ev_tr := v1tr &
 [ V1 ev_tr ].
v1_ev2_tr := v1tr &
 [ V1 ev2_tr ].
v1_ev3_tr := v1tr &
 [ V1 ev3_tr ].
v1_ev_ditr := v1ditr &
 [ V1 ev_ditr ].
v1_ev2_ditr := v1ditr &
 [ V1 ev2_ditr ].
v1_ev3_ditr := v1ditr &
 [ V1 ev3_ditr ].
; applying the above to v2 in a series
v2_ev_intr := v2intr &
 [ V2 ev_intr ].
v2_ev2_intr := v2intr &
 [ V2 ev2_intr ].
v2_ev3_intr := v2intr &
 [ V2 ev3_intr ].
v2_ev_tr := v2tr &
 [ V2 ev_tr ].
v2_ev2_tr := v2tr &
 [ V2 ev2_tr ].
v2_ev3_tr := v2tr &
 [ V2 ev3_tr ].
v2_ev_ditr := v2ditr &
 [ V2 ev_ditr ].
v2_ev2_ditr := v2ditr &
 [ V2 ev2_ditr ].
v2_ev3_ditr := v2ditr &
 [ V2 ev3_ditr ].
; applying the above to v3 in a series
v3_ev_intr := v3intr &
 [ V3 ev_intr ].
v3_ev2_intr := v3intr &
 [ V3 ev2_intr ].
v3_ev3_intr := v3intr &
 [ V3 ev3_intr ].
v3_ev_tr := v3tr &
 [ V3 ev_tr ].
v3_ev2_tr := v3tr &
 [ V3 ev2_tr ].
v3_ev3_tr := v3tr &
 [ V3 ev3_tr ].
v3_ev_ditr := v3ditr &
 [ V3 ev_ditr ].
v3_ev2_ditr := v3ditr &
 [ V3 ev2_ditr ].
v3_ev3_ditr := v3ditr &
 [ V3 ev3_ditr ].


sv_suID-v1tr-v2pv1tr-v2_pv2intr-v2tr := svSuID & v1tr & v2pv1tr & v2pv2intr & v2tr.

