;; sc
; no subject-linking. Possibly obj-linking - it has to be, when an object at all, since not both su and ob are nonlinked. Try to lure the system to make a choice, via subtypes?
scSuNrg := sign &
 [ GF.SUBJ.INDX #1,
   GF.SCPR.INDX #2,
   GF.SCPR.XACT #1,
   ACTNTS.ACT1.KIND.ACT0 #2,
   ACTNTS.ACT1.KIND.ACT1 #1 ].
; these would be the candidates, the first for intrScpr and the other for trScpr; however, even though these are the only options *defined*, the system makes a third subtype of scSuNrg where there is an object, but nonlinked.
scSuNrgNoobject := scSuNrg &
 [ GF scpr-gf-strict ].
scSuNrgObjectlnk := scSuNrg & obj-act2-link &
 [ GF su-ob-scpr-gf ].
; thus, the only way of enforcing correct choice is the 'non-compositional' following:
trScpr-scSuNrg := trScpr & scSuNrg & obj-act2-link.
; Better might be to rather write the label type as:
;   trScpr-scSuNrg_obArg
; to retain full perspicuity.

; no object-linking. Possibly subj-linking. One can actually assume there is subj-linking, since not both su and ob are nonlinked.
scObNrg := su-act1-link &
 [ GF.OBJ.INDX #1,
   GF.SCPR.INDX #2,
   GF.SCPR.XACT #1,
   ACTNTS.ACT1.KIND.ACT0 #2,
   ACTNTS.ACT1.KIND.ACT1 #1 ].
scObArgConcurr := sign &
 [ GF.SUBJ.INDX #0,
   GF.OBJ.INDX #1,
   GF.SCPR.INDX #2,
   GF.SCPR.XACT #1,
   ACTNTS.PRED concur_rel,
   ACTNTS.ACT1.KIND.ACT1 #0,
   ACTNTS.ACT1.KIND.ACT2 #1,
   ACTNTS.ACT2.KIND.ACT0 #2,
   ACTNTS.ACT2.KIND.ACT1 #1 ]. 
scObNrgRes := su-act1-link &
 [ GF.OBJ.INDX #1,
   GF.SCPR.INDX #2,
   GF.SCPR.XACT #1,
   ACTNTS.PRED cause_rel,
   ACTNTS.ACT2.KIND.ACT0 #2,
   ACTNTS.ACT2.KIND.ACT1 #1 ].
scSuArgCsd := sign &
 [ GF.SUBJ.INDX #1,
   GF.SCPR.INDX #2,
   GF.SCPR.XACT #1,
   ACTNTS.PRED cause_rel,
   ACTNTS.ACT1.KIND.ACT1 #1,
   ACTNTS.ACT2.KIND.ACT0 #2,
   ACTNTS.ACT2.KIND.ACT1 #1 ]. 
scResIncrm := scSuArgCsd &
 [ ASPECT compl_monodvmnt,
   ACTNTS.AKTRT monodvmnt ].
scSuNrgCsd := sign &
 [ GF.SUBJ.INDX #1,
   GF.SCPR.INDX #2,
   GF.SCPR.XACT #1,
   ACTNTS.PRED cause_rel,
   ACTNTS.ACT2.KIND.ACT0 #2,
   ACTNTS.ACT2.KIND.ACT1 #1 ]. 
scSuNrgResIncrm := scSuNrgCsd &
 [ ASPECT compl_monodvmnt,
   ACTNTS.AKTRT monodvmnt ].
scObArgCsd := sign &
 [ GF.SUBJ.INDX #1,
   GF.OBJ.INDX #3,
   GF.SCPR.INDX #2,
   GF.SCPR.XACT #3,
   ACTNTS.PRED cause_rel,
   ACTNTS.ACT1.KIND.ACT1 #1,
   ACTNTS.ACT1.KIND.ACT2 #3,
   ACTNTS.ACT2.KIND.ACT0 #2,
   ACTNTS.ACT2.KIND.ACT1 #3 ]. 
scObArgRes := scObArgCsd.
scObNrgCsd  := sign &
 [ GF.SUBJ.INDX #1,
   GF.OBJ.INDX #3,
   GF.SCPR.INDX #2,
   GF.SCPR.XACT #3,
   ACTNTS.PRED cause_rel,
   ACTNTS.ACT1.KIND.ACT1 #1,
   ACTNTS.ACT2.KIND.ACT0 #2,
   ACTNTS.ACT2.KIND.ACT1 #3 ]. 
 
scAdj := scpr-sign & [GF.SCPR.HEAD adjective].
scAdj_agr := scpr-sign & [GF.SCPR.HEAD adjective]. 
scN := scpr-sign & [GF.SCPR.HEAD noun].  
scPP := scpr-sign & [GF.SCPR.HEAD prep].  
scPrtcl := scpr-sign & [GF.SCPR.HEAD particle].  
scAdv := scpr-sign & [GF.SCPR.HEAD adverb].  
scPredprtcl := scpr-sign & [GF.SCPR.HEAD predparticle].  
scInf := scpr-sign & [GF.SCPR.HEAD infmark].  
scBareinf := scpr-sign & [GF.SCPR.HEAD verb,
			  GF.SCPR.TENSE infin].  
scPerf := scpr-sign & [ GF.SCPR.HEAD verb,
			GF.SCPR.TENSE perfprtcpl]. 
vidObPostp := sign & 
	[GF.OBL.HEAD verb,
	 GF.OBL.GF.GOV poss-lex &
