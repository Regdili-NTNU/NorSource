    SYNSEM.LOCAL.CAT.QVAL.DOBJECT #5 & [LOCAL.CONT.HOOK.INDEX #7],
    SYNSEM.LOCAL.CAT.VAL.ICOMPS <[LOCAL.CAT.QVAL.IOBJECT #9 & [LOCAL.CONT.HOOK.INDEX #11]]>,
    DAEMON [VSIGNS.FIRST [ SUBJCT #2 & catg,
			  DOBJCT #6 & catg ],
	    VSIGNS.REST.FIRST.IOBJCT #10 & catg,
	    VSIGNS.FIRST.PARTCPNTS.ACT1 #4,
	    VSIGNS.FIRST.PARTCPNTS.ACT2 #8,
	    VSIGNS.REST.FIRST.PARTCPNTS.ACT3 #12,
	     SAME-GF gf-list & < same-gf &
 				[FRST-GF #1,
  				 SEC-GF #2], 
			     same-gf &
			     [FRST-GF #5,
  				 SEC-GF #6], 
			     same-gf &
			     [FRST-GF #9,
  				 SEC-GF #10] >,
	     SAME-ACTANT  act-list & < same-act &
 				[FRST-ARG #3 & [SORT #4],
  				 SEC-ACT #4],
				   same-act &
 				[FRST-ARG #7 & [SORT #8],
  				 SEC-ACT #8],
				   same-act &
 				[FRST-ARG #11 & [SORT #12],
  				 SEC-ACT #12] > ] ].

trans-mainverb-isvc-tr-tr-objshare-loc-lexeme-daem := trans-mainverb-isvc-tr-tr-objshare-loc-lexeme  &
  [ SYNSEM trans-arg1-2-isvc-tr-tr-objshare-synsem,
    SYNSEM.LOCAL.CAT.QVAL.SUBJECT #1 & [LOCAL.CONT.HOOK.INDEX #3],
    SYNSEM.LOCAL.CAT.QVAL.DOBJECT #5 & [LOCAL.CONT.HOOK.INDEX #7],
    SYNSEM.LOCAL.CAT.VAL.ICOMPS <[LOCAL.CAT.QVAL.IOBJECT #9 & [LOCAL.CONT.HOOK.INDEX #11]]>,
    DAEMON [VSIGNS.FIRST [ SUBJCT #2 & catg,
			  DOBJCT #6 & catg ],
	    VSIGNS.REST.FIRST.IOBJCT #10 & catg,
	    VSIGNS.FIRST.PARTCPNTS.ACT1 #4,
	    VSIGNS.FIRST.PARTCPNTS.ACT2 #8,
	    VSIGNS.REST.FIRST.PARTCPNTS.ACT3 #12,
	     SAME-GF gf-list & < same-gf &
 				[FRST-GF #1,
  				 SEC-GF #2], 
			     same-gf &
			     [FRST-GF #5,
  				 SEC-GF #6], 
			     same-gf &
			     [FRST-GF #9,
  				 SEC-GF #10] >,
	     SAME-ACTANT  act-list & < same-act &
 				[FRST-ARG #3 & [SORT #4],
  				 SEC-ACT #4],
				   same-act &
 				[FRST-ARG #7 & [SORT #8],
  				 SEC-ACT #8],
				   same-act &
 				[FRST-ARG #11 & [SORT #12],
  				 SEC-ACT #12] > ] ].




