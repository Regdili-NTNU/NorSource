   SYNSEM.LOCAL.CAT.VAL.SUBJ < #sbj & [LOCAL.CAT.HEAD #pron] >,
   SYNSEM.LOCAL.CAT.VAL.COMPS < #dobj, #pres >,
   SYNSEM.LOCAL.CAT.QVAL.SUBJECT #sbj,
   SYNSEM.LOCAL.CAT.QVAL.DOBJECT #dobj,
   SYNSEM.LOCAL.CAT.QVAL.PRESNTL #pres ].

;leaving open how Nrf ('non-referentiality') is to be reflected
trNrfPresnt-lex := lexeme &
 [ SYNSEM.LOCAL trPresnt-signe & [GF.SBJ #1],
