   SYNSEM.LOCAL.GF.OBJ #2,
   SYNSEM.LOCAL.GF.ADV #4,
   SYNSEM.LOCAL.CMPS < #2, #3, #4 >,
   SYNSEM.LOCAL.CAT.VAL.SUBJ < #sbj & [LOCAL.CAT.HEAD #pron] >,
   SYNSEM.LOCAL.CAT.VAL.COMPS < #dobj, #pres, #adv >,
