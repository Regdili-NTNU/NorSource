trObl-lex := subjarg-lex & lexeme &
 [ SYNSEM.LOCAL trObl-signe & [GF.OBJ #2 & [INDX #arg2],
			      GF.OBL #1 & [GF.GOV.INDX #govnee]],
   SYNSEM.LOCAL.CMPS < #2, #1 >,
   SYNSEM.LOCAL.CAT.VAL.COMPS < #dirob & [LOCAL.CONT.HOOK.INDEX #arg2],
				#obl & [LOCAL.CONT.HOOK.INDEX #index2] >,
   SYNSEM.LOCAL.CAT.QVAL.DOBJECT #dirob & [LOCAL.CONT.HOOK.INDEX #arg2],
   SYNSEM.LOCAL.CAT.QVAL.OBL1 #obl & [LOCAL.CONT.HOOK.INDEX #index2,
				      LOCAL.CAT.QVAL.DOBJECT.LOCAL.CONT.HOOK.INDEX #govnee],
   SYNSEM.LOCAL.CAT.VAL.SUBJ < [LOCAL.CONT.HOOK.INDEX #index] >,
   SYNSEM.LOCAL.CONT.RELS <! arg12obl-rel & [ARG1 #index, ARG2 #arg2, ARGOBLQ #index2] !>  ].

trNrfObl-lex := lexeme &
