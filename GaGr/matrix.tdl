 [ SYNSEM.LOCAL dbob-signe & [GF.OBJ #1,
			     GF.OBJ2 #2,
			     GF.OBJ3 #3],
   SYNSEM.LOCAL.CMPS < #1, #2, #3 >,
   SYNSEM.LOCAL.CAT.VAL.COMPS < #firstobj & [LOCAL.CONT.HOOK.INDEX #index2], #secobj & [LOCAL.CONT.HOOK.INDEX #index3], #thirdobj & [LOCAL.CONT.HOOK.INDEX #index4] >,
   SYNSEM.LOCAL.CAT.VAL.SUBJ < [LOCAL.CONT.HOOK.INDEX #index] >,
   SYNSEM.LOCAL.CAT.QVAL.OBJECT1 #firstobj,
   SYNSEM.LOCAL.CAT.QVAL.OBJECT2 #secobj,
   SYNSEM.LOCAL.CAT.QVAL.OBJECT3 #thirdobj,
   SYNSEM.LOCAL.CONT.RELS <! arg1234-relation & [ARG1 #index, ARG2 #index2, ARG3 #index3, ARG4 #index4] !>  ].

