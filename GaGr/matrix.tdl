   SYNSEM.LOCAL.GF.OBJ #2,
   SYNSEM.LOCAL.GF.EXPN #3,
   SYNSEM.LOCAL.SPS < #1>,
   SYNSEM.LOCAL.CMPS < #2 & [POS #pron & pron ], #3 >,
   SYNSEM.LOCAL.CAT.VAL.SUBJ < #sbj >,
   SYNSEM.LOCAL.CAT.VAL.COMPS < #dobj, #expn >,
   SYNSEM.LOCAL.CAT.QVAL.SUBJECT #sbj,
   SYNSEM.LOCAL.CAT.QVAL.DOBJECT #dobj & [LOCAL.CAT.HEAD #pron],
   SYNSEM.LOCAL.CAT.QVAL.EXTRAPOS #expn ].

;leaving open how Nrf ('non-referentiality') is to be reflected
trNrfExpnSu-lex := lexeme &
 [ SYNSEM.LOCAL trExpnSu-signe & [GF.SBJ #1],
   SYNSEM.LOCAL.GF.OBJ #2,
   SYNSEM.LOCAL.GF.EXPN #3,
   SYNSEM.LOCAL.SPS < #1 & [POS #pron & pron ]>,
   SYNSEM.LOCAL.CMPS < #2, #3 >,
   SYNSEM.LOCAL.CAT.VAL.SUBJ < #sbj & [LOCAL.CAT.HEAD #pron] >,
   SYNSEM.LOCAL.CAT.VAL.COMPS < #dobj, #expn >,
   SYNSEM.LOCAL.CAT.QVAL.SUBJECT #sbj,
   SYNSEM.LOCAL.CAT.QVAL.DOBJECT #dobj,
   SYNSEM.LOCAL.CAT.QVAL.EXTRAPOS #expn ].

;leaving open how Nrf ('non-referentiality') is to be reflected
trNrf-lex := lexeme &
 [ SYNSEM.LOCAL trNrf-signe & [GF.SBJ #1],
   SYNSEM.LOCAL.GF.OBJ #2,
   SYNSEM.LOCAL.SPS < #1>,
   SYNSEM.LOCAL.CMPS < #2 & [POS #pron & pron ] >,
   SYNSEM.LOCAL.CAT.VAL.SUBJ < #sbj >,
   SYNSEM.LOCAL.CAT.VAL.COMPS < #dobj >,
   SYNSEM.LOCAL.CAT.QVAL.SUBJECT #sbj,
   SYNSEM.LOCAL.CAT.QVAL.DOBJECT #dobj & [LOCAL.CAT.HEAD #pron] ].

trComp-lex := lexeme &
 [ SYNSEM.LOCAL trComp-signe & [GF.SBJ #1],
   SYNSEM.LOCAL.GF.OBJ #2,
   SYNSEM.LOCAL.GF.COMP #3,
   SYNSEM.LOCAL.SPS < #1 >,
   SYNSEM.LOCAL.CMPS < #2, #3 >,
   SYNSEM.LOCAL.CAT.VAL.SUBJ < #sbj >,
   SYNSEM.LOCAL.CAT.VAL.COMPS < #dobj, #cmplcl >,
   SYNSEM.LOCAL.CAT.QVAL.SUBJECT #sbj,
   SYNSEM.LOCAL.CAT.QVAL.DOBJECT #dobj,
   SYNSEM.LOCAL.CAT.QVAL.COMPLCLSE #cmplcl ].

;leaving open how Nrf ('non-referentiality') is to be reflected
trNrfComp-lex := lexeme &
 [ SYNSEM.LOCAL trComp-signe & [GF.SBJ #1],
   SYNSEM.LOCAL.GF.OBJ #2 & [POS #pron & pron],
   SYNSEM.LOCAL.GF.COMP #3,
   SYNSEM.LOCAL.SPS < #1 >,
   SYNSEM.LOCAL.CMPS < #2, #3 >,
   SYNSEM.LOCAL.CAT.VAL.SUBJ < #sbj >,
   SYNSEM.LOCAL.CAT.VAL.COMPS < #dobj, #cmplcl >,
   SYNSEM.LOCAL.CAT.QVAL.SUBJECT #sbj,
   SYNSEM.LOCAL.CAT.QVAL.DOBJECT #dobj & [LOCAL.CAT.HEAD #pron],
   SYNSEM.LOCAL.CAT.QVAL.COMPLCLSE #cmplcl ].
 
ditr-lex := subjarg-lex & lexeme &
 [ SYNSEM.LOCAL ditr-signe & [GF.OBJ #2,
			     GF.IOBJ #1],
   SYNSEM.LOCAL.CMPS < #1, #2 >,
   SYNSEM.LOCAL.CAT.VAL.COMPS < #indobj & [LOCAL.CONT.HOOK.INDEX #index3], #dirobj & [LOCAL.CONT.HOOK.INDEX #index2] >,
   SYNSEM.LOCAL.CAT.VAL.SUBJ < #sbj & [LOCAL.CONT.HOOK.INDEX #index] >,
   SYNSEM.LOCAL.CAT.QVAL.SUBJECT #sbj & [LOCAL.CONT.HOOK.INDEX #index],
   SYNSEM.LOCAL.CAT.QVAL.IOBJECT #indobj & [LOCAL.CONT.HOOK.INDEX #index3],
   SYNSEM.LOCAL.CAT.QVAL.DOBJECT #dirobj & [LOCAL.CONT.HOOK.INDEX #index2],
   SYNSEM.LOCAL.CONT.RELS <! arg123-relation & [ARG1 #index, ARG2 #index2, ARG3 #index3 & [ROLE beneficiary]] !>  ].

v-ditr-lex := ditr-lex & verb-lexeme.

dbob-lex := subjarg-lex & lexeme &
 [ SYNSEM.LOCAL dbob-signe & [GF.OBJ #1,
			     GF.OBJ2 #2],
   SYNSEM.LOCAL.CMPS < #1, #2 >,
   SYNSEM.LOCAL.CAT.VAL.COMPS < #firstobj & [LOCAL.CONT.HOOK.INDEX #index2], #secndobj & [LOCAL.CONT.HOOK.INDEX #index3] >,
   SYNSEM.LOCAL.CAT.VAL.SUBJ < #sbj & [LOCAL.CONT.HOOK.INDEX #index] >,
   SYNSEM.LOCAL.CAT.QVAL.SUBJECT #sbj & [LOCAL.CONT.HOOK.INDEX #index],
   SYNSEM.LOCAL.CAT.QVAL.OBJECT2 #secndobj & [LOCAL.CONT.HOOK.INDEX #index3],
   SYNSEM.LOCAL.CAT.QVAL.OBJECT1 #firstobj & [LOCAL.CONT.HOOK.INDEX #index2],
   SYNSEM.LOCAL.CONT.RELS <! arg123-relation & [ARG1 #index, ARG2 #index2 & [ROLE theme-mover], ARG3 #index3 & [ROLE endpnt]] !>  ].

v-dbob-lex := dbob-lex & verb-lexeme.

