;;; -*- Mode: TDL; Package: LKB -*-
;;;
;;;
;;; -*- Mode: tdl; Coding: utf-8; -*-
;;;
;;;
;;;              GaGr
;;;  A small computational grammar of Ga
;;;
;;;  Copyright @ Lars Hellan
;;;
;;;   First version: 2005-2008, by Lars Hellan and Mary Esther Kropp Dakubu
;;;   Second version:  2020, by Lars hellan
;;;
;;;   For general comments, see 'readme.tdl
;;;
;;;
;;;  matrix.tdl for GaGr
;;;    Part 1: Features of 'tg' (TypeGram') - see 'readme'.
;;;    Part 2: Original and enriched Matrix v. 06
;;;
;;;  PART 1. Features of 'tg' (TypeGram')


signe := local &
 [  POS head,
    GF  gramfct,
    ACTNT relation,
    INDX semarg, 
    XACT semarg,
    SPS list, ; for 'specifier', old in tg 'SPR'
    CMPS list,
    MODF list,
    DTRS list ].
    
gramfct := avm.

;;;
;;; grammatical functions
;;;

subj-gf := gramfct & [ SBJ signe ].
obj-gf := subj-gf & [ OBJ signe ].
gov-gf := gramfct  & [ GOV signe ].
iobj-gf := obj-gf & [ IOBJ signe ].
obj2-gf := obj-gf & [ OBJ2 signe ].
obj3-gf := obj2-gf & [ OBJ3 signe ].
obj4-gf := obj3-gf & [ OBJ4 signe ].
obl-gf := gramfct & [ OBL signe ].
su-obl-gf := subj-gf & obl-gf.
spec-gf := gramfct & [ SPC signe ].
su-ob-obl-gf := obj-gf & obl-gf.
su-ob-iob-obl-gf := iobj-gf & obl-gf.
su-ob-ob2-obl-gf := obj2-gf & obl-gf.
scpr-gf := subj-gf & [ SCPR signe ].
su-scpr-expn-gf := scpr-gf & su-expn-gf.
su-scpr-adv-gf := scpr-gf & adv-gf.
scpr-gf-strict := scpr-gf.
su-ob-scpr-gf := obj-gf & scpr-gf.
adv-gf := gramfct & [ ADV signe ].
su-adv-gf := subj-gf & adv-gf.
su-ob-adv-gf := obj-gf & su-adv-gf.
su-obl-adv-gf := obl-gf & su-adv-gf.
su-obl-scpr-gf := obl-gf & scpr-gf.
su-adv-scpr-gf := adv-gf & scpr-gf.
su-ob-obl-adv-gf := obl-gf & su-adv-gf & obj-gf.
pres-gf := gramfct & [ PRES signe ].
su-pres-gf := subj-gf & pres-gf.
su-ob-pres-gf := obj-gf & pres-gf.
su-ob-adv-pres-gf := obj-gf & pres-gf & adv-gf.
obl-pres-gf := obl-gf & pres-gf.
adv-pres-gf := adv-gf & pres-gf.
su-obl-pres-gf := subj-gf & obl-gf & pres-gf.
su-adv-pres-gf := subj-gf & adv-gf & pres-gf.
expn-gf := gramfct & [ EXPN signe ].
su-expn-gf := expn-gf & subj-gf.
su-ob-expn-gf := su-expn-gf & obj-gf.
su-ob-iob-expn-gf := su-ob-expn-gf & iobj-gf.
su-obl-expn-gf := expn-gf & subj-gf & obl-gf.
su-ob-obl-expn-gf := su-expn-gf & obj-gf & obl-gf.
su-adv-expn-gf := expn-gf & subj-gf & adv-gf.
comp-gf := gramfct & [ COMP signe ].
su-comp-gf := subj-gf & comp-gf.
su-ob-comp-gf := obj-gf & comp-gf.
idnt-gf := subj-gf & [ IDNT signe ].


actnt := relation &
 [ ACT0 semarg ]. 

kind := avm.
pred := predsort.

indiv := kind.
sachverhalt := kind.

act1-rel := actnt &
 [ ACT1 semarg ].
act12-rel := act1-rel &
 [ ACT2 semarg ].
act123-rel := act12-rel &
 [ ACT3 semarg ].
dir-rel := actnt &
 [ DIR actnt ].
act1dir-rel := act1-rel & dir-rel.
act12dir-rel := act12-rel & dir-rel.
loc-rel := actnt &
 [ LOC actnt ].
act1loc-rel := act1-rel & loc-rel.
act12loc-rel := act12-rel & loc-rel.
obl-rel := actnt &
 [ ACTobl semarg ].
act1obl-rel := act1-rel & obl-rel.
act12obl-rel := act12-rel & obl-rel.
act123obl-rel := act123-rel & obl-rel.
act1234-rel := act123-rel &
 [ ACT4 semarg ].
act1234obl-rel := act1234-rel & obl-rel.
act12345-rel := act1234-rel &
 [ ACT5 semarg ].
causation-with-causingevent := act12-rel &
 [ PRED cause_rel].
causation-with-causer := act12-rel &
 [ PRED cause_rel ].
concurrence := act12-rel &
 [ PRED concur_rel ]. 
;,
;   ACT1.KIND sachverhalt,
;   ACT2.KIND sachverhalt].
;; a question how to construe situational embedding for these ACT.
; previously as here:
;   ACT1.KIND actnt,
;   ACT2.KIND actnt
;LH17052020


cause_rel := pred.
concur_rel := pred.
fall_rel := pred.
poss_rel := pred.
spatial-coord_rel := pred.
bodypart_rel := pred.
part-of_rel := pred.
unif-su_rel := pred.
unif-ob_rel := pred.

su-act1-link := subj-signe &
 [ GF.SBJ.INDX #1,
   ACTNT.ACT1 #1 ].
; no SUBJECT:
gov-act2-link := gov-signe &
 [ GF.GOV.INDX #1,
   ACTNT.ACT2 #1 ].
; explet SUBJECT in transitive constr:
obj-act1-link := obj-signe &
 [ GF.OBJ.INDX #1,
   ACTNT.ACT1 #1 ].
; with SUBJECT:
obj-act2-link := obj-signe &
 [ GF.OBJ.INDX #1,
   ACTNT.ACT2 #1 ].
iob-act3-link := iobj-signe &
 [ GF.IOBJ.INDX #1,
   ACTNT.ACT3 #1 ].
ob2-act3-link := obj2-signe &
 [ GF.OBJ2.INDX #1,
   ACTNT.ACT3 #1 ].
ob3-act4-link := obj3-signe &
 [ GF.OBJ3.INDX #1,
   ACTNT.ACT4 #1 ].
ob4-act5-link := obj4-signe &
 [ GF.OBJ4.INDX #1,
   ACTNT.ACT5 #1 ].
obl-actObl-link := obl-signe &
 [ GF.OBL.GF.GOV.INDX #1,
   ACTNT.ACTobl #1 ].
spec-act2-link := spec-signe & 
 [ INDX #2,
   GF.SPC.INDX #1,
   ACTNT.ACT2 #2,
   ACTNT.ACT1 #1 ].
pres-act1-link := pres-signe &
 [ GF.PRES.INDX #1,
   ACTNT.ACT1 #1 ].
expn-act1-link := expn-signe &
 [ GF.EXPN.INDX #1,
   ACTNT.ACT1 #1 ].
expn-act2-link := expn-signe &
 [ GF.EXPN.INDX #1,
   ACTNT.ACT2 #1 ].
comp-act1-link := comp-signe &
 [ GF.COMP.INDX #1,
   ACTNT.ACT1 #1 ].
comp-act2-link := comp-signe &
 [ GF.COMP.INDX #1,
   ACTNT.ACT2 #1 ].
comp-act3-link := comp-signe &
 [ GF.COMP.INDX #1,
   ACTNT.ACT3 #1 ].
idnt-act2-link := idnt-signe &
 [ GF.IDNT.INDX #1,
   ACTNT.ACT2 #1 ].
adv-act1-link := adv-signe &
 [ GF.ADV.INDX #1,
   ACTNT.ACT1 #1 ].

v-signe := signe & [ POS verb-all-super ].

; these sign specifications say nothing about the semantics of the sign.
subj-signe := signe & [ GF subj-gf ].
gov-signe := signe & [ GF gov-gf ].
obj-signe := signe & [ GF obj-gf ].
iobj-signe := signe & [ GF iobj-gf ].
obj2-signe := signe & [ GF obj2-gf ].
obj3-signe := signe & [ GF obj3-gf ].
obj4-signe := signe & [ GF obj4-gf ].
obl-signe := signe & [ GF obl-gf ].
;(This GF is only associated with nouns:)
spec-signe := signe & [ GF spec-gf ].
scpr-signe := signe & [ GF scpr-gf ].
adv-signe := signe & [ GF adv-gf ].
pres-signe := signe & [ GF pres-gf ].
expn-signe := signe & [ GF expn-gf ].
comp-signe := signe & [ GF comp-gf ].
idnt-signe := signe & [ GF idnt-gf ].


; these sign specifications cover grammatical functions and semantics of the sign.
poss-signe := spec-act2-link.
intr-signe := su-act1-link.
v-intr-signe := intr-signe & v-signe.
intrObl-signe := obl-actObl-link & intr-signe.
v-intrObl-signe := intrObl-signe & v-signe.
; no semantic linkage defined here:
intrScpr-signe := scpr-signe.
v-intrScpr-signe := intrscpr-signe & v-signe.
intrAdv-signe := adv-signe & intr-signe.
v-intrAdv-signe := intrAdv-signe & v-signe.
intrOblAdv-signe := intrObl-signe & intrAdv-signe.
v-intrOblAdv-signe := intrOblAdv-signe & v-signe.
intrScprObl-signe := intrscpr-signe & intrObl-signe.
intrScprAdv-signe := intrscpr-signe & adv-signe.
intrPresnt-signe := pres-act1-link & subj-signe.
v-intrPresnt-signe := intrPresnt-signe & v-signe.
intrPresntAdv-signe := pres-act1-link & subj-signe & adv-signe.
v-intrPresntAdv-signe := intrPresntAdv-signe & v-signe.
intrExpn-signe := expn-act1-link & subj-signe.
intrOblExpn-signe := intrExpn-signe & obl-actObl-link.
intrAdvExpn-signe := intrExpn-signe & adv-signe.
intrComp-signe := intr-signe & comp-act2-link.
intrImpltransfAdv-signe := subj-signe & adv-signe &
 [ GF.SBJ.INDX #1,
   GF.ADV.INDX #3,
   ACTNT causation-with-causingevent &
		[ ACT1.E.K [ACT1 #1],
		  ACT1.E.K [ACT2 #2],
		  ACT2.E.K [ACT0 #3,
			    ACT1 #2]]].
tr-signe := intr-signe & obj-act2-link.
v-tr-signe := tr-signe & v-signe.
trObl-signe := obl-actObl-link & tr-signe.
trNrfObl-signe := obl-actObl-link & su-act1-link & obj-signe.
v-trObl-signe := trObl-signe & v-signe.
; no semantic linkage defined here:
trScpr-signe := obj-signe & scpr-signe.
v-trScpr-signe := trscpr-signe & v-signe.
trAdv-signe := adv-signe & tr-signe.
trNrfAdv-signe := adv-signe & su-act1-link & obj-signe.
v-trAdv-signe := trAdv-signe & v-signe.
trOblAdv-signe := intrObl-signe & trAdv-signe.
v-trOblAdv-signe := trOblAdv-signe & v-signe.
trPresnt-signe := pres-act1-link & obj-act2-link & subj-signe.
trNrfPresnt-signe := pres-act1-link & obj-signe & subj-signe.
trNrfPresntAdv-signe := pres-act1-link & obj-signe & subj-signe.
trExpnSu-signe := expn-act1-link & obj-act2-link  & subj-signe.
trExpnOb-signe := expn-act2-link & su-act1-link  & obj-signe.
trNrfExpnSu-signe := expn-act1-link & obj-signe & subj-signe.
trNrf-signe := su-act1-link & obj-signe.
trComp-signe := tr-signe & comp-act3-link.
trNrfComp-signe := su-act1-link & obj-signe & comp-act2-link.

ditr-signe := tr-signe & iob-act3-link.
v-ditr-signe := ditr-signe & v-signe.
dbob-signe := tr-signe & ob2-act3-link.
tritr-signe := dbob-signe & ob3-act4-link.
qtrtr-signe := tritr-signe & ob4-act5-link.
v-dbob-signe := dbob-signe & v-signe.
ditrObl-signe := obl-actObl-link & ditr-signe.
v-ditrObl-signe := ditrObl-signe & v-signe.
dbobObl-signe := obl-actObl-link & dbob-signe.
v-dbobObl-signe := dbobObl-signe & v-signe.
ditrNrf-signe := tr-signe & iobj-signe.  
ditrExpnSu-signe := expn-act1-link & obj-act2-link & subj-signe & iob-act3-link.

;; See file labels.tdl in TypeGram for omitted part:   scSuNrg &  TODO
copPred-signe := intrScpr-signe & 
 [ GF.SCPR.INDX #1,
   ACTNT.ACT0 #1 ].
copId-signe := su-act1-link & idnt-act2-link.
copExpn-signe := expn-act1-link & subj-signe & intrScpr-signe &
 [ GF.SCPR.INDX #1,
   ACTNT.ACT0 #1 ].

copImpersAdv-signe := scpr-signe & subj-signe & adv-act1-link &
 [ GF.SCPR.INDX #1,
   ACTNT.ACT0 #1,
   GF.SCPR.XACT #2,
   ACTNT.ACT1 #2 ].

; no SUBJECT:
gvmt-signe := gov-act2-link.
intrImpers-signe := subj-signe.
intrImpersObl-signe := intrImpers-signe & obl-actObl-link.
intrImpersComp-signe := intrImpers-signe & comp-act1-link.
trImpers-signe := subj-signe & obj-act1-link.
trImpersComp-signe := trImpers-signe & comp-act2-link.


; signs for morphological causatives:
; sign with a person-causer and the ACT1 of the caused event expressed as object:
; 	  ACT2.KIND act1-rel & [ ACT1 #2 ]]].
trCs-signe := obj-signe &
 [ GF.SBJ.INDX #1,
   GF.OBJ.INDX #2, ; & [KIND indiv],
   ACTNT causation-with-causer &
	[ ACT1 #1,
	  ACT2.E.K act1-rel & [ ACT1 #2 ]]].
v-trCs-signe := trCs-signe & v-signe.


; sign with a person-causer and the ACT1 of the caused event expressed as object and ACT2 of the caused event as 2nd object:
dbobCs-signe := trCs-signe & obj2-signe &
 [ GF.OBJ2.INDX #3,
   ACTNT [ ACT2.E.K act12-rel & [ ACT2 #3 ]]].
v-dbobCs-signe := dbobCs-signe & v-signe.

; sign with a person-causer and the ACT1 of the caused event expressed as iobject and ACT2 of the caused event as (direct) object:
ditrCs-signe := iobj-signe &
 [ GF.SBJ.INDX #1,
   GF.IOBJ.INDX #2, ; & [KIND indiv],
   GF.OBJ.INDX #3,
   ACTNT causation-with-causer &
	[ ACT1 #1,
	  ACT2.E.K act12-rel & [ ACT1 #2,
				  ACT2 #3 ]]].
v-ditrCs-signe := ditrCs-signe & v-signe.

; sign with a person-causer and the ACT1 of the caused event (the "causee") expressed as obl and ACT2 of the caused event as (direct) object:
trOblCs-oblCsu-signe := obj-signe & obl-signe &
 [ GF.SBJ.INDX #1,
   GF.OBL.GF.OBJ.INDX #2, ; & [KIND indiv],
   GF.OBJ.INDX #3,
   ACTNT causation-with-causer &
	[ ACT1 #1,
	  ACT2.E.K act12-rel & [ ACT1 #2,
				  ACT2 #3 ]]].
v-trOblCs-oblCsu-signe := trOblCs-oblCsu-signe & v-signe.

; sign with a person-causer and the ACT1 of the caused event (the "causee") expressed as ob and ACT2 of the caused event as obl:
trOblCs-obCsu-signe := obj-signe & obl-signe &
 [ GF.SBJ.INDX #1,
   GF.OBL.GF.OBJ.INDX #3, ; & [KIND indiv],
   GF.OBJ.INDX #2,
   ACTNT causation-with-causer &
	[ ACT1 #1,
	  ACT2.E.K act12-rel & [ ACT1 #2,
				  ACT2 #3 ]]].
v-trOblCs-obCsu-signe := trOblCs-obCsu-signe & v-signe.


;Lexical types

nullval-lex := sign &
 [ SYNSEM.LOCAL.SPS <>,
   SYNSEM.LOCAL.CMPS <> ].

subjarg-lex := sign &
 [ SYNSEM.LOCAL intr-signe & [GF.SBJ #1 & [INDX #index],
			     INDX #5],
   SYNSEM.LOCAL.SPS < #1 >,
   SYNSEM.LOCAL.CAT.VAL.SUBJ < #subj & [LOCAL #1 & [CONT.HOOK.INDEX #index]] >,
   SYNSEM.LOCAL.CAT.QVAL.SUBJECT #subj & [LOCAL #1 & [CONT.HOOK.INDEX #index]],
   SYNSEM.LOCAL.CONT.HOOK.INDEX #5,
   SYNSEM.LOCAL.CONT.HOOK.XARG #index,
   SYNSEM.LOCAL.CONT.RELS <! [ARG1 #index] !> ].

; main-verb-lexeme &
intr-lex := subjarg-lex & lexeme &
 [ SYNSEM.LOCAL.CMPS < >,
   SYNSEM.LOCAL.CAT.VAL.COMPS < >,
   SYNSEM.LOCAL.CAT.QVAL intr-valence ].

v-intr-lex := intr-lex & verb-lexeme.

;still TODO: semantics
intrImpers-lex := lexeme &
 [ SYNSEM.LOCAL intrImpers-signe & [GF.SBJ #1],
   SYNSEM.LOCAL.SPS < #1 & [POS #pron & pron ]>,
   SYNSEM.LOCAL.CMPS < >,
   SYNSEM.LOCAL.CAT.VAL.SUBJ < #sbj & [LOCAL.CAT.HEAD #pron ]>,
   SYNSEM.LOCAL.CAT.QVAL.SUBJECT #sbj,
   SYNSEM.LOCAL.CAT.VAL.COMPS < > ].

intrImpersObl-lex := lexeme &
 [ SYNSEM.LOCAL intrImpersObl-signe & [GF.SBJ #1],
   SYNSEM.LOCAL.SPS < #1 & [POS #pron & pron ]>,
   SYNSEM.LOCAL.GF.OBL #2,
   SYNSEM.LOCAL.CMPS < #2 >,
   SYNSEM.LOCAL.CAT.VAL.SUBJ < #sbj & [LOCAL.CAT.HEAD #pron ]>,
   SYNSEM.LOCAL.CAT.QVAL.SUBJECT #sbj,
   SYNSEM.LOCAL.CAT.VAL.COMPS < #obl >,
   SYNSEM.LOCAL.CAT.QVAL.OBL1 #obl ].

intrImpersComp-lex := lexeme &
 [ SYNSEM.LOCAL intrImpersComp-signe & [GF.SBJ #1],
   SYNSEM.LOCAL.SPS < #1 & [POS #pron & pron ]>,
   SYNSEM.LOCAL.GF.COMP #2,
   SYNSEM.LOCAL.CMPS < #2 >,
   SYNSEM.LOCAL.CAT.VAL.SUBJ < #sbj & [LOCAL.CAT.HEAD #pron ]>,
   SYNSEM.LOCAL.CAT.QVAL.SUBJECT #sbj,
   SYNSEM.LOCAL.CAT.VAL.COMPS < #cmplcl >,
   SYNSEM.LOCAL.CAT.QVAL.COMPLCLSE #cmplcl ].

;intrObl-lex := subjarg-lex & intrObl-signe &
; [ GF.OBL #1,
;   CMPS < #1 >,
;   SYNSEM.LOCAL.CAT.VAL.COMPS < #1 > ].

intrObl-lex := subjarg-lex & lexeme &
 [ SYNSEM.LOCAL intrObl-signe & [GF.OBL #1 & [GF.GOV.INDX #govnee]],
   SYNSEM.LOCAL.CMPS < #1 >,
   SYNSEM.LOCAL.CAT.VAL.COMPS < #obl & [LOCAL[CONT.HOOK.INDEX #index2]] >,
   SYNSEM.LOCAL.CAT.QVAL.OBL1 #obl & [LOCAL.CONT.HOOK.INDEX #index2,
				      LOCAL.CAT.QVAL.DOBJECT.LOCAL.CONT.HOOK.INDEX #govnee],
   SYNSEM.LOCAL.CAT.VAL.SUBJ < [LOCAL.CONT.HOOK.INDEX #index] >,
   SYNSEM.LOCAL.CONT.RELS <! arg1obl-rel & [ARG1 #index, ARGOBLQ #index2] !>  ].

;TODO hookup to SUBJ and COMPS and QVAL
intrOblRais-lex := lexeme &
 [ SYNSEM.LOCAL obl-actObl-link & [GF.SBJ #2],
   SYNSEM.LOCAL.GF.OBL.GF.GOV.GF.SBJ #2 ].

intrAdvOblRais-lex := obl-actObl-link & lexeme &
 [ SYNSEM.LOCAL obl-actObl-link & [GF.SBJ #2],
   SYNSEM.LOCAL.GF.OBL #1 & [GF.GOV.GF.SBJ #2],
   SYNSEM.LOCAL.GF.ADV #3,
   SYNSEM.LOCAL.SPS < #2 >,
   SYNSEM.LOCAL.CMPS < #3, #1 >,
   SYNSEM.LOCAL.CAT.VAL.SUBJ < #sbj >,
   SYNSEM.LOCAL.CAT.QVAL.SUBJECT #sbj,
   SYNSEM.LOCAL.CAT.VAL.COMPS < #adv, #obl >,
   SYNSEM.LOCAL.CAT.QVAL.ADVERBIAL #adv,
   SYNSEM.LOCAL.CAT.QVAL.OBL1 #obl ].

intrImpersAdv-lex := lexeme &
 [ SYNSEM.LOCAL intrImpers-signe & [GF.ADV #1],
   SYNSEM.LOCAL.CMPS < #1 >,
   SYNSEM.LOCAL.CAT.VAL.COMPS < #adv >,
   SYNSEM.LOCAL.CAT.QVAL.ADVERBIAL #adv ].

intrScpr-lex := lexeme &
 [ SYNSEM.LOCAL intrScpr-signe & [GF.SCPR #1],
   SYNSEM.LOCAL.CMPS < #1 >,
   SYNSEM.LOCAL.CAT.VAL.COMPS < #scpr >,
   SYNSEM.LOCAL.CAT.QVAL.SCPRED #scpr ].

intrAdv-lex := subjarg-lex & lexeme &
 [ SYNSEM.LOCAL intrAdv-signe & [GF.ADV #1],
   SYNSEM.LOCAL.CMPS < #1 >,
   SYNSEM.LOCAL.CAT.VAL.COMPS < #adv >,
   SYNSEM.LOCAL.CAT.QVAL.ADVERBIAL #adv ].

intrOblAdv-lex := subjarg-lex & lexeme &
 [ SYNSEM.LOCAL intrAdv-signe & intrObl-signe & [GF.OBL #1],
   SYNSEM.LOCAL.GF.ADV #2,
   SYNSEM.LOCAL.CMPS < #1, #2 >,
   SYNSEM.LOCAL.CAT.VAL.COMPS < #obl, #adv >,
   SYNSEM.LOCAL.CAT.QVAL.ADVERBIAL #adv,
   SYNSEM.LOCAL.CAT.QVAL.OBL1 #obl ].

intrScprObl-lex := lexeme &
 [ SYNSEM.LOCAL intrScprObl-signe & [GF.SBJ #0],
   SYNSEM.LOCAL.GF.OBL #1,
   SYNSEM.LOCAL.GF.SCPR #2,
   SYNSEM.LOCAL.SPS < #0 >,
   SYNSEM.LOCAL.CMPS < #2, #1 >,
   SYNSEM.LOCAL.CAT.VAL.SUBJ < #sbj >,
   SYNSEM.LOCAL.CAT.VAL.COMPS < #scpr, #obl >,
   SYNSEM.LOCAL.CAT.QVAL.SUBJECT #sbj,
   SYNSEM.LOCAL.CAT.QVAL.OBL1 #obl,
   SYNSEM.LOCAL.CAT.QVAL.SCPRED #scpr ].

intrScprAdv-lex := lexeme & 
 [ SYNSEM.LOCAL intrScprAdv-signe & [GF.SBJ #0],
   SYNSEM.LOCAL.GF.ADV #1,
   SYNSEM.LOCAL.GF.SCPR #2,
   SYNSEM.LOCAL.SPS < #0 >,
   SYNSEM.LOCAL.CMPS < #2, #1 >,
   SYNSEM.LOCAL.CAT.VAL.SUBJ < #sbj >,
   SYNSEM.LOCAL.CAT.VAL.COMPS < #scpr, #adv >,
   SYNSEM.LOCAL.CAT.QVAL.SUBJECT #sbj,
   SYNSEM.LOCAL.CAT.QVAL.SCPRED #scpr,
   SYNSEM.LOCAL.CAT.QVAL.ADVERBIAL #adv ].

intrAdvScpr-lex := lexeme & 
 [ SYNSEM.LOCAL intrScprAdv-signe & [GF.SBJ #0],
   SYNSEM.LOCAL.GF.ADV #1,
   SYNSEM.LOCAL.GF.SCPR #2,
   SYNSEM.LOCAL.SPS < #0 >,
   SYNSEM.LOCAL.CMPS < #2, #1 >,
   SYNSEM.LOCAL.CAT.VAL.SUBJ < #sbj >,
   SYNSEM.LOCAL.CAT.VAL.COMPS < #adv, #scpr >,
   SYNSEM.LOCAL.CAT.QVAL.SUBJECT #sbj,
   SYNSEM.LOCAL.CAT.QVAL.SCPRED #scpr,
   SYNSEM.LOCAL.CAT.QVAL.ADVERBIAL #adv ].

intrAdvObl-lex := subjarg-lex & lexeme &
 [ SYNSEM.LOCAL intrAdv-signe & intrObl-signe & [GF.OBL #1],
   SYNSEM.LOCAL.GF.ADV #2,
   SYNSEM.LOCAL.CMPS < #2, #1 >,
   SYNSEM.LOCAL.CAT.VAL.COMPS < #adv, #obl >,
   SYNSEM.LOCAL.CAT.QVAL.ADVERBIAL #adv,
   SYNSEM.LOCAL.CAT.QVAL.OBL1 #obl ].

intrPresnt-lex := lexeme &
 [ SYNSEM.LOCAL intrPresnt-signe & [GF.SBJ #1],
   SYNSEM.LOCAL.SPS < #1 & [POS #pron & pron ]>,
   SYNSEM.LOCAL.GF.PRES #2,
   SYNSEM.LOCAL.CMPS < #2 >,
   SYNSEM.LOCAL.CAT.VAL.SUBJ < #sbj & [LOCAL.CAT.HEAD #pron ] >,
   SYNSEM.LOCAL.CAT.VAL.COMPS < #pres >,
   SYNSEM.LOCAL.CAT.QVAL.SUBJECT #sbj,
   SYNSEM.LOCAL.CAT.QVAL.PRESNTL #pres ].

intrPresntAdv-lex := lexeme &
 [ SYNSEM.LOCAL intrPresntAdv-signe & [GF.SBJ #1],
   SYNSEM.LOCAL.GF.PRES #2,
   SYNSEM.LOCAL.GF.ADV #3,
   SYNSEM.LOCAL.SPS < #1 & [POS #pron & pron ]>,
   SYNSEM.LOCAL.CMPS < #2, #3 >,
   SYNSEM.LOCAL.CAT.VAL.SUBJ < #sbj & [LOCAL.CAT.HEAD #pron ] >,
   SYNSEM.LOCAL.CAT.VAL.COMPS < #pres, #adv >,
   SYNSEM.LOCAL.CAT.QVAL.SUBJECT #sbj,
   SYNSEM.LOCAL.CAT.QVAL.PRESNTL #pres,
   SYNSEM.LOCAL.CAT.QVAL.ADVERBIAL #adv ].

intrExpn-lex := lexeme &
 [ SYNSEM.LOCAL intrExpn-signe & [GF.SBJ #1],
   SYNSEM.LOCAL.GF.EXPN #2,
   SYNSEM.LOCAL.SPS < #1 & [POS #pron & pron ]>,
