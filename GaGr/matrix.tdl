   SYNSEM.LOCAL.CAT.VAL.COMPS < #extr >,
   SYNSEM.LOCAL.CAT.QVAL.SUBJECT #sbj,
   SYNSEM.LOCAL.CAT.QVAL.EXTRAPOS #extr ].

intrOblExpn-lex := lexeme &
 [ SYNSEM.LOCAL intrOblExpn-signe & [GF.SBJ #1],
   SYNSEM.LOCAL.GF.OBL #3,
   SYNSEM.LOCAL.GF.EXPN #2,
   SYNSEM.LOCAL.SPS < #1 & [POS #pron & pron ]>,
   SYNSEM.LOCAL.CMPS < #3, #2 >,
   SYNSEM.LOCAL.CAT.VAL.SUBJ < #sbj & [LOCAL.CAT.HEAD #pron ] >,
   SYNSEM.LOCAL.CAT.VAL.COMPS < #obl, #extr >,
   SYNSEM.LOCAL.CAT.QVAL.SUBJECT #sbj,
   SYNSEM.LOCAL.CAT.QVAL.EXTRAPOS #extr,
   SYNSEM.LOCAL.CAT.QVAL.OBL1 #obl ].

intrAdvExpn-lex := intrAdvExpn-signe & sign &
 [ SYNSEM.LOCAL intrAdvExpn-signe & [GF.SBJ #1],
   SYNSEM.LOCAL.GF.ADV #3,
   SYNSEM.LOCAL.GF.EXPN #2,
   SYNSEM.LOCAL.SPS < #1 & [POS #pron & pron ]>,
   SYNSEM.LOCAL.CMPS < #3, #2 >,
   SYNSEM.LOCAL.CAT.VAL.SUBJ < #sbj & [LOCAL.CAT.HEAD #pron ] >,
   SYNSEM.LOCAL.CAT.VAL.COMPS < #adv, #extr >,
   SYNSEM.LOCAL.CAT.QVAL.SUBJECT #sbj,
   SYNSEM.LOCAL.CAT.QVAL.EXTRAPOS #extr,
   SYNSEM.LOCAL.CAT.QVAL.ADVERBIAL #adv ].

intrOblExlnk-lex := lexeme &
 [ SYNSEM.LOCAL obl-actObl-link & subj-signe & [GF.SBJ #1],
   SYNSEM.LOCAL.GF.OBL #2 & [GF.GOV.INDX #event & event],
   SYNSEM.LOCAL.SPS < #1 & [POS #pron & pron ]>,
   SYNSEM.LOCAL.CMPS < #2 >,
   SYNSEM.LOCAL.CAT.VAL.SUBJ < #sbj & [LOCAL.CAT.HEAD #pron ] >,
   SYNSEM.LOCAL.CAT.VAL.COMPS < #obl >,
   SYNSEM.LOCAL.CAT.QVAL.SUBJECT #sbj,
   SYNSEM.LOCAL.CAT.QVAL.OBL1 #obl & [LOCAL.CAT.HEAD prep,
				      LOCAL.CAT.QVAL.DOBJECT.LOCAL.CONT.HOOK.INDEX #event] ].

intrAdvOblExlnk-lex := lexeme &
 [ SYNSEM.LOCAL obl-actObl-link & subj-signe & adv-signe & [GF.SBJ #1],
   SYNSEM.LOCAL.GF.OBL #2 & [GF.GOV.INDX #event & event],
   SYNSEM.LOCAL.GF.ADV #3,
   SYNSEM.LOCAL.SPS < #1 & [POS #pron & pron ]>,
   SYNSEM.LOCAL.CMPS < #3, #2 >,
   SYNSEM.LOCAL.CAT.VAL.SUBJ < #sbj & [LOCAL.CAT.HEAD #pron ] >,
   SYNSEM.LOCAL.CAT.VAL.COMPS < #adv, #obl >,
   SYNSEM.LOCAL.CAT.QVAL.SUBJECT #sbj,
   SYNSEM.LOCAL.CAT.QVAL.ADVERBIAL #adv,
   SYNSEM.LOCAL.CAT.QVAL.OBL1 #obl & [LOCAL.CAT.HEAD prep,
				      LOCAL.CAT.QVAL.DOBJECT.LOCAL.CONT.HOOK.INDEX #event] ].

intrComp-lex := subjarg-lex & lexeme &
 [ SYNSEM.LOCAL intrComp-signe & [GF.COMP #1],
   SYNSEM.LOCAL.CMPS < #1 >,
   SYNSEM.LOCAL.CAT.VAL.SUBJ < #sbj >,
   SYNSEM.LOCAL.CAT.QVAL.SUBJECT #sbj,
   SYNSEM.LOCAL.CAT.VAL.COMPS < #cmplcl >,
   SYNSEM.LOCAL.CAT.QVAL.COMPLCLSE #cmplcl ].

; "spill on the table"
intrImpltransfAdv-lex := lexeme &
 [ SYNSEM.LOCAL intrImpltransfAdv-signe & [GF.ADV #1],
   SYNSEM.LOCAL.CMPS < #1 >,
   SYNSEM.LOCAL.CAT.VAL.SUBJ < #sbj >,
   SYNSEM.LOCAL.CAT.VAL.COMPS < #adv >,
   SYNSEM.LOCAL.CAT.QVAL.SUBJECT #sbj,
   SYNSEM.LOCAL.CAT.QVAL.ADVERBIAL #adv ].

tr-lex := subjarg-lex & lexeme &
 [ SYNSEM.LOCAL tr-signe & [GF.OBJ #1 & [INDX #index2]],
   SYNSEM.LOCAL.CMPS < #1 >,
   SYNSEM.LOCAL.CAT.VAL.COMPS < #dirobj & [LOCAL [CONT.HOOK.INDEX #index2]] >,
   SYNSEM.LOCAL.CAT.VAL.SUBJ < [LOCAL.CONT.HOOK.INDEX #index] >,
   SYNSEM.LOCAL.CAT.QVAL.DOBJECT #dirobj & [LOCAL.CONT.HOOK.INDEX #index2],
   SYNSEM.LOCAL.CONT.RELS <! arg12-relation & [ARG1 #index, ARG2 #index2] !>,
   SYNSEM.LOCAL.CONT.HOOK.VARG #index2 ].

v-tr-lex := tr-lex & verb-lexeme.

trImpers-lex := lexeme &
 [ SYNSEM.LOCAL trImpers-signe & [GF.SBJ #2],
   SYNSEM.LOCAL.SPS < #2 & [POS pron ]>,
   SYNSEM.LOCAL.GF.OBJ #1,
   SYNSEM.LOCAL.CMPS < #1 >,
   SYNSEM.LOCAL.CAT.VAL.SUBJ < #sbj >,
   SYNSEM.LOCAL.CAT.QVAL.SUBJECT #sbj,
   SYNSEM.LOCAL.CAT.VAL.COMPS < #dirobj >,
   SYNSEM.LOCAL.CAT.QVAL.DOBJECT #dirobj ].

trImpersComp-lex := lexeme &
 [ SYNSEM.LOCAL trImpersComp-signe & [GF.SBJ #1],
   SYNSEM.LOCAL.SPS < #1 & [POS #pron & pron]>,
   SYNSEM.LOCAL.GF.OBJ #3,
   SYNSEM.LOCAL.GF.COMP #2,
   SYNSEM.LOCAL.CMPS < #3, #2 >,
   SYNSEM.LOCAL.CAT.VAL.SUBJ < #sbj >,
   SYNSEM.LOCAL.CAT.QVAL.SUBJECT #sbj & [LOCAL.CAT.HEAD #pron],
   SYNSEM.LOCAL.CAT.VAL.COMPS < #dirobj, #compcl >,
   SYNSEM.LOCAL.CAT.QVAL.DOBJECT #dirobj,
   SYNSEM.LOCAL.CAT.QVAL.COMPLCLSE #compcl ].

;trObl-lex := subjarg-lex & trObl-signe &
